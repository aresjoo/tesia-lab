/* 하단 근처일 때만 자동 스크롤, 위에서 읽는 중이면 '새 응답 보기' 칩만. 스페이서는 실콘텐츠 하단 기준 */
function gScrollBottom(force){
  var s=$('g-scroll'); if(!s) return;
  var c=$('g-newmsg'),sp=$('g-spacer');
  var ref=(sp&&sp.parentNode)?sp.offsetTop:s.scrollHeight;
  var gap=ref-s.scrollTop-s.clientHeight;
  if(force){ s.scrollTop=Math.max(0,ref-s.clientHeight+24); if(c) c.hidden=true; }
  else if(gap<140){ if(gap>0) s.scrollTop=ref-s.clientHeight+24; if(c) c.hidden=true; }
  else if(c&&!$('g-composer-wrap').hidden) c.hidden=false;
}

