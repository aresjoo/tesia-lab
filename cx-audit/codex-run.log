/* ── 방향성 확률 게이지: 방향 질문 답변에 1개, up+down=100 ── */
function taiGauge(g){
  if(!g||g.up==null||g.down==null) return '';
  var up=Math.max(0,Math.min(100,Math.round(+g.up||0)));
  var down=100-up; /* 합 100 강제 정규화 */
  var lb=gEsc(g.label||g.symbol||'');
  return '<div class="g-gauge"><div class="t"><b>'+lb+'</b><span>방향 확률'+(g.symbol?', '+gEsc(g.symbol):'')+'</span></div
>'
    +'<div class="bar"><span class="u" style="width:'+up+'%"></span><span class="d" style="width:'+down+'%"></span></di
v>'
    +'<div class="lg"><span class="u">상승 '+up+'%</span><span class="d">하락 '+down+'%</span></div></div>';
}
