/* 톤앤매너 스크롤바: 얇고 트랙 투명, 썸은 라인 토큰 */
#g-root *{scrollbar-width:thin;scrollbar-color:var(--gl2) transparent}
#g-root ::-webkit-scrollbar{width:5px;height:5px}
#g-root ::-webkit-scrollbar-track{background:transparent}
#g-root ::-webkit-scrollbar-thumb{background:var(--gl2);border-radius:99px}
