/* 스트리밍: 실제 AbortController 중지 + 요청 ID로 늦게 도착한 stale 이벤트 차단 */
function taiStream(system,msgs,onText,onDone,onFail,onMeta){
  var got=false;
  var ctrl=('AbortController' in window)?new AbortController():null;
  TAI.rq=(TAI.rq||0)+1; var myId=TAI.rq;
  TAI.req={id:myId,ctrl:ctrl};
  taiBusySync();
  function alive(){ return TAI.req&&TAI.req.id===myId; }
  function fin(){ if(alive()){ TAI.req=null; taiBusySync(); } }
  fetch(TAI.url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({system:system,messages:
msgs}),signal:ctrl?ctrl.signal:undefined})
    .then(function(r){
      if(!r.ok||!r.body) throw 0;
      var rd=r.body.getReader(),dec=new TextDecoder(),buf='';
      function pump(){ return rd.read().then(function(x){
        if(x.done||!alive()) return;
        buf+=dec.decode(x.value,{stream:true});
        var lines=buf.split('\n'); buf=lines.pop();
        for(var i=0;i<lines.length;i++){
          var L=lines[i]; if(L.indexOf('data: ')!==0) continue;
          var ev; try{ ev=JSON.parse(L.slice(6)); }catch(e){ continue; }
          if(ev.error&&!got) throw 0;
          if(alive()&&onMeta){ /* 실작업 메타: 서버 툴(검색/페이지/코드) / 사고 스트림 / 누적 토큰 / 최종 usage */
            if(ev.think) onMeta({think:ev.think});
            if(ev.tok) onMeta({tok:ev.tok});
            if(ev.tool) onMeta({tool:ev.tool});
            if(ev.sres) onMeta({sres:ev.sres});
            if(ev.fres) onMeta({fres:ev.fres});
            if(ev.tres) onMeta({tres:ev.tres});
            if(ev.done&&ev.usage) onMeta({usage:ev.usage});
          }
          if(ev.text&&alive()){ got=true; onText(ev.text); }
        }
        return pump(); });
      }
      return pump().then(function(){ fin(); if(!got) throw 0; TAI.ok=true; onDone(); });
    })
    .catch(function(err){
      var aborted=err&&err.name==='AbortError';
      fin();
      if(!aborted&&!got) TAI.ok=false;
      onFail(aborted?(got?'abort-partial':'abort'):(got?'error-partial':'error'));
    });
}
function taiStop(){ if(TAI.req&&TAI.req.ctrl) TAI.req.ctrl.abort(); }
