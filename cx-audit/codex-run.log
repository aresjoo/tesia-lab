/* 사고 스트림 행: 실제 thinking delta가 실시간으로 흘러들어온다 */
function actThink(run){
  var h=actStep(run,{kind:'think',title:'생각하는 중',h:'생각을 정리하는 중',verb:'생각하는 중',detail:'<div class="cot2"></div>',open:tr
ue});
  var buf='';
  return {
    push:function(d){
      if(!d) return;
      if(!buf) d=String(d).replace(/^\s+/,''); /* 첫 청크 선행 개행 제거 */
      buf=(buf+d).replace(/\n{3,}/g,'\n\n'); /* 연속 빈 줄 압축 — 줄바꿈 폭탄 방지 */
      h.st.think=buf;
      if(h.st.el&&h.st.el.isConnected){ var box=h.st.el.querySelector('.cot2'); if(box) box.textContent=buf; gScrollBot
tom(); }
    },
    done:function(){
      if(h.st.status!=='running') return;
      /* 부드러운 접힘: DOM 재생성 대신 상태만 전환해 그리드 트랜지션이 살아 있게 */
      h.st.status='done'; h.st.open=false;
      h.st.title='생각 완료'; h.st.mR=Math.max(1,Math.round((Date.now()-h.st.t0)/1000))+'초';
      h.st.ms=Date.now()-h.st.t0;
      h.st.detail=buf?'<div class="cot2">'+gEsc(buf)+'</div>':null;
      var el=h.st.el;
      if(el&&el.isConnected&&el.querySelector('.ab')){
        el.className='ar done think';
        var tic=el.querySelector('.tic'); if(tic) tic.outerHTML=actTic(h.st);
        var at=el.querySelector('.at'); if(at) at.textContent=h.st.title;
        var btn=el.querySelector('.arh');
        if(btn&&h.st.mR&&!el.querySelector('.am')){ var am=document.createElement('span'); am.className='am'; am.textCo
ntent=h.st.mR; var cv=btn.querySelector('.chev'); btn.insertBefore(am,cv||null); }
        el.querySelector('.ab').classList.remove('open');
        if(btn) btn.setAttribute('aria-expanded','false');
      } else actPaint(null,h.st);
      STORE.save();
    },
    st:h.st
  };
}
/* 사고 연출 스트림: 실데이터 기반 문장을 타자 속도로 흘린다. 문장 완료 콜백으로 행 생성과 순차 동기.
   실제 thinking/내레이터가 흐르는 동안은 양보(real), 끝나면 resume으로 재개 */
function taiThinkSim(th,run){
  var q=[],busy=false,real=false,closed=false,onEmpty=null,total=0;
  function dead(){ return closed||real||(run&&run.data.status!=='running'); }
  function drainDone(){ if(onEmpty){ var f=onEmpty; onEmpty=null; f(); } }
  function flushCbs(){ q.forEach(function(it){ if(it.cb) try{ it.cb(); }catch(e){} }); q=[]; }
  function pump(){
    if(dead()){ busy=false; flushCbs(); drainDone(); return; }
    if(!q.length){ busy=false; drainDone(); return; }
    busy=true;
    var it=q[0], ch=it.s.slice(0,2); it.s=it.s.slice(2);
    th.push(ch);
    if(!it.s.length){ q.shift(); th.push(' '); var c=it.cb; setTimeout(function(){ if(c) try{ c(); }catch(e){} pump(); 
},380); }
    else setTimeout(pump,24+Math.random()*20);
  }
  return {
    feed:function(s,cb){
      if(dead()||!s||total>1600){ if(cb) cb(); return; }
      /* 큐가 비어 있으면 직전 내용(내레이터 원문 등)과의 이음새에 공백 하나를 큐 순서대로 삽입 */
      total+=s.length; q.push({s:((busy||q.length)?'':' ')+s,cb:cb||null}); if(!busy) pump();
    },
    real:function(){ real=true; flushCbs(); },
    resume:function(){ real=false; if(q.length&&!busy) pump(); },
    flush:function(){ /* 종료 직전: 타이핑 남은 문장을 즉시 덤프해 중간 절단을 막는다 */
      closed=true;
      q.forEach(function(it){ th.push(it.s+' '); if(it.cb) try{ it.cb(); }catch(e){} }); q=[];
    },
    wrap:function(endS,cb){
      if(closed){ cb&&cb(); return; }
      if(endS&&!real&&run&&run.data.status==='running'){ total=0; this.feed(endS); }
      onEmpty=function(){ closed=true; cb&&cb(); };
      if(!busy&&!q.length) drainDone();
    }
  };
}
/* 사고 내레이터: 경량 실모델(하이쿠)이 본답변과 병렬로 1인칭 사고를 실제 생성·스트리밍.
   첫 델타가 오면 템플릿 연출(sim)은 양보하고, 본답변 시작/실사고 도착/중단 시 abort */
function taiNarrate(th,sim,prompt,onEnd){
  var ctrl=('AbortController' in window)?new AbortController():null;
  var first=true,dead=false,ended=false;
  function fin(){ if(ended||dead) return; ended=true; if(onEnd) try{ onEnd(); }catch(e){} }
  fetch(TAI.url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({think:true,messages:[{r
ole:'user',content:prompt}]}),signal:ctrl?ctrl.signal:undefined})
    .then(function(r){
      if(!r.ok||!r.body) throw 0;
      var rd=r.body.getReader(),dec=new TextDecoder(),buf='';
      function pump(){ return rd.read().then(function(x){
        if(x.done||dead) return;
        buf+=dec.decode(x.value,{stream:true});
        var L=buf.split('\n'); buf=L.pop();
        for(var i=0;i<L.length;i++){
          if(L[i].indexOf('data: ')!==0) continue;
          var ev; try{ ev=JSON.parse(L[i].slice(6)); }catch(e){ continue; }
          if(ev.text&&!dead){ if(first){ first=false; sim.real(); th.push('\n\n'); } th.push(ev.text); }
        }
        return pump(); });
      }
      return pump();
    }).then(fin).catch(function(){ fin(); });
  return { abort:function(){ dead=true; try{ if(ctrl) ctrl.abort(); }catch(e){} } };
}
/* 실검색 결과 리스트 (모델이 실제 수행한 웹 검색의 실제 URL) */
function actSrcList(rs){
  return '<div class="srclist">'+rs.map(function(r){
    var d=''; try{ d=new URL(r.u).hostname.replace(/^www\./,''); }catch(e){}
    return '<a class="srow" href="'+gEsc(r.u)+'" target="_blank" rel="noopener noreferrer"><img class="fv" src="https:/
/www.google.com/s2/favicons?domain='+gEsc(d)+'&sz=32" alt=""><span class="tt">'+gEsc(r.t)+'</span><span class="dm">'+gE
sc(d)+'</span></a>';
  }).join('')+'</div>';
}
function actFinish(run,mode,usage){
  var d=run.data; if(d.status!=='running') return;
  d.status=mode; d.ms=Date.now()-d.t0;
  if(usage&&usage.out) d.tok=usage.out;
  d.steps.forEach(function(s){ if(s.status==='running'){ s.status='failed'; s.title=s.title+(mode==='abort'?', 중단됨':'')
; } });
  clearInterval(run.timer); delete ACT.live[run.id];
  document.querySelectorAll('.g-chartcard.pip').forEach(function(x){ x.classList.remove('pip'); }); /* 중단 시 PiP 잔류 방지 *
/
  if(run.el&&run.el.isConnected) actRenderFinal(run.el,d);
  STORE.save();
}
/* 완료/복원 공용 정적 렌더 — 접힌 요약 헤더 + 클릭 시 전체 타임라인 */
function actRenderFinal(el,d){
  /* 단계 수: 세그먼트로 쪼개진 생각/답변 행은 종류당 1단계로만 센다 */
  var seen={},n=0;
  d.steps.forEach(function(s){ if(s.kind==='note') return; if(s.kind==='think'||s.kind==='ans'){ if(seen[s.kind]) retur
n; seen[s.kind]=1; } n++; });
  var secs=d.ms?Math.round(d.ms/1000)+'초':'';
  var head=d.status==='done'?('작업 완료, '+n+'단계'+(secs?', '+secs:'')):d.status==='abort'?('작업 중단, '+n+'단계'):('작업 오류, '+n+
'단계');
  el.classList.add('fin'); el.classList.remove('open');
  el.innerHTML='<button class="hd" aria-expanded="false" aria-controls="'+d.id+'-tl" onclick="actToggle(\''+d.id+'\')">
'
   +'<span class="tic '+(d.status==='done'?'ok':'fail')+'">'+(d.status==='done'?'<svg width="10" height="10" viewBox="0
 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4
 12.5l5 5L20 6.5"/></svg>':'!')+'</span>'
   +'<span class="hlb">'+gEsc(head)+'</span>'+(d.tok?'<span class="els">'+Number(d.tok).toLocaleString()+' 토큰</span>':'
')
   +'<svg class="chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" st
roke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>'
   +'<div class="tl" id="'+d.id+'-tl"><div class="tlin"></div></div>';
  var tl=el.querySelector('.tlin');
  d.steps.forEach(function(s){ var r=document.createElement('div'); var tmp={el:r}; for(var k in s) tmp[k]=s[k]; tmp.el
=r; tmp.open=false; actPaint(null,tmp); tl.appendChild(r); });
}
function actToggle(id){
  var el=$(id); if(!el) return;
  var show=!el.classList.contains('open');
  el.classList.toggle('open',show);
  var hd=el.querySelector('.hd'); if(hd) hd.setAttribute('aria-expanded',show?'true':'false');
}
function actRowToggle(btn){
  var ab=btn.closest('.ab'); if(!ab||!ab.querySelector('.ad')) return;
  var show=!ab.classList.contains('open');
  ab.classList.toggle('open',show);
  btn.setAttribute('aria-expanded',show?'true':'false');
}
function actHydrate(sess,el){
  var id=el.getAttribute('data-run');
  var d=sess&&sess.acts&&sess.acts[id];
  if(!d){ el.remove(); return; }
  if(d.status==='running'){ d.status='abort'; d.steps.forEach(function(s){ if(s.status==='running') s.status='failed'; 
}); } /* 새로고침 등으로 끊긴 기록 */
  actRenderFinal(el,d);
}
