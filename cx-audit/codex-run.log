/* 후속 질문 + 실행 액션 통합 칩 목록 — 액션칩은 유도칩과 같은 컨테이너, 같은 간격의 한 목록 안에 섞인다 */
function taiNext(items,acts){
  items=items||[];
  acts=(acts||[]).filter(function(a){ return a&&a.label&&TAI_ACT_IC[a.type]; }).slice(0,2);
  if(!items.length&&!acts.length) return;
  taiNextClear();
  TAI.nn=(TAI.nn||0)+1; var id='gnx'+TAI.nn;
  TAI.acfg=TAI.acfg||{}; TAI.acfg[id]=acts;
  var badge=!(S.user&&S.user.plan); /* 구독자(plan 보유)에겐 무료 배지 미노출 */
  var rows=items.map(function(q){ return {t:'n',q:q}; });
  /* 자연스러운 위치: 유도칩이 있으면 두 번째 슬롯에, 없으면 맨 앞에 */
  var at=Math.min(1,rows.length);
  acts.forEach(function(a,i){ rows.splice(at+i,0,{t:'a',a:a,i:i}); });
  var el=taiThreadAdd('<div class="g-nextcol" id="'+id+'">'+rows.map(function(r){
    if(r.t==='a') return '<button class="g-acbtn" data-a="'+r.i+'"><span class="lf">'+TAI_ACT_IC[r.a.type]+'<span class
="tx">'+gEsc(r.a.label)+'</span></span><span class="rt">'+(badge?'<span class="bdg">무료, 즉시</span>':'')+'<span class="ar
">→</span></span></button>';
    return '<button class="g-nextq" data-q="'+gEsc(r.q).replace(/"/g,'&quot;')+'"><span>'+gEsc(r.q)+'</span><span class
="ar">→</span></button>';
  }).join('')+'</div>');
  if(el){
    el.querySelectorAll('.g-nextq').forEach(function(b){ b.onclick=function(){ var f=$('g-in'); if(f){ f.value=b.getAtt
ribute('data-q'); gSend(); } }; });
    el.querySelectorAll('.g-acbtn').forEach(function(b){ b.onclick=function(){ taiActRun(id,+b.getAttribute('data-a'),b
); }; });
  }
}
