+import fs from 'node:fs';
+
+const html = fs.readFileSync('index.html', 'utf8');
+
+function functionSource(name) {
+  const start = html.indexOf(`function ${name}`);
+  if (start < 0) throw new Error(`missing ${name}`);
+  const next = html.indexOf('\nfunction ', start + 10);
+  return html.slice(start, next < 0 ? html.length : next);
+}
+
+globalThis.gStep = null;
+const taiConvSystemForAudit = eval(`(${functionSource('taiConvSystem')})`);
+const taiMarketRulesForAudit = eval(`(${functionSource('taiMarketRules')})`);
+const system = taiConvSystemForAudit() + taiMarketRulesForAudit()
+  + '\n[세션 작업 상태] 브라우저 UI가 아닌 감사용 프록시 호출이다. 실시세 스냅샷과 열린 차트는 없다.'
+  + '\n[메모리 원칙] 이전 대화에 이미 있는 정보는 다시 묻지 않는다. 실시세 스냅샷이 없으면 구체적 수치를 만들지 말고 확인이 필요하다고 말한다.';
+
+const endpoint = 'http://localhost:8799/api/chat';
+
+async function ask(id, prompt, history = []) {
+  const started = performance.now();
+  let firstTextMs = null;
+  let answer = '';
+  let buffer = '';
+  const meta = { thinkChars: 0, tools: [], searchResults: 0, usage: null };
+  const response = await fetch(endpoint, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Origin: 'https://aresjoo.github.io' },
+    body: JSON.stringify({ system, messages: history.concat([{ role: 'user', content: prompt }]) }),
+  });
+  if (!response.ok || !response.body) throw new Error(`${id}: HTTP ${response.status}`);
+  const reader = response.body.getReader();
+  const decoder = new TextDecoder();
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    buffer += decoder.decode(value, { stream: true });
+    const lines = buffer.split('\n');
+    buffer = lines.pop() || '';
+    for (const line of lines) {
+      if (!line.startsWith('data: ')) continue;
+      let event;
+      try { event = JSON.parse(line.slice(6)); } catch { continue; }
+      if (event.text) {
+        if (firstTextMs === null) firstTextMs = Math.round(performance.now() - started);
+        answer += event.text;
+      }
+      if (event.think) meta.thinkChars += String(event.think).length;
+      if (event.tool) meta.tools.push(event.tool.name || 'unknown');
+      if (event.sres && Array.isArray(event.sres.results)) meta.searchResults += event.sres.results.length;
+      if (event.done && event.usage) meta.usage = event.usage;
+    }
+  }
+  const result = {
+    id,
+    prompt,
+    http: response.status,
+    firstTextMs,
+    totalMs: Math.round(performance.now() - started),
+    meta,
+    answer,
+  };
+  console.log(`\n=== ${id} ===\n${JSON.stringify(result, null, 2)}`);
+  return result;
+}
+
+const btcHistory = [];
+for (const [id, prompt] of [
+  ['T01', '비트코인 지금 사도 돼?'],
+  ['T02', '그럼 언제 사는 게 나아?'],
+  ['T03', '손절은 어디에 두면 돼?'],
+  ['T04', '그 조건으로 자동매매 전략 만들어줘.'],
+  ['T05', '방금 답변은 현재 시세 스냅샷이 없는데도 방향 확률이나 가격 기준을 확정한 것처럼 말했어. 근거 없는 수치 아닌가? 틀렸다면 정정해.'],
+]) {
+  const result = await ask(id, prompt, btcHistory);
+  btcHistory.push({ role: 'user', content: prompt }, { role: 'assistant', content: result.answer });
+}
+
+for (const [id, prompt] of [
+  ['T06', '테슬라 전망 분석해줘'],
+  ['T07', '이더리움 시세'],
+  ['T08', 'SK에코플랜트 어때?'],
+  ['T09', '돈 벌고 싶어'],
+  ['T10', '김치찌개 레시피 알려줘'],
+  ['T11', '주식 1도 모르는데 뭐부터 해?'],
+  ['T12', '나 대신 사줘'],
+]) await ask(id, prompt);
+
+const delegated = await ask('T13', '비트코인으로, 하락 후 반등 방식으로 해줘.', [
+  { role: 'user', content: '나 대신 사줘' },
