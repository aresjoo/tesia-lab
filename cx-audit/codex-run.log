/* 미니 마크다운 렌더러 (이스케이프 후 변환이라 XSS 안전): ### 헤더, **볼드**, `코드`, 불릿, | 표 |, > 콜아웃 */
function taiMd(src){
  function inl(s){ return s.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>').replace(/`([^`]+)`/g,'<code>$1</code>'); }
  function tblHtml(rows){
    var cells=rows.map(function(r){ return r.replace(/^\s*\||\|\s*$/g,'').split('|').map(function(c){ return c.trim(); 
}); });
    cells=cells.filter(function(cs){ return !cs.every(function(c){ return /^:?-{2,}:?$/.test(c)||c===''; }); });
    if(!cells.length) return '';
    var h='<div class="tblwrap"><table><tr>'+cells[0].map(function(c){ return '<th>'+inl(c)+'</th>'; }).join('')+'</tr>
';
    for(var r=1;r<cells.length;r++) h+='<tr>'+cells[r].map(function(c){ return '<td>'+inl(c)+'</td>'; }).join('')+'</tr
>';
    return h+'</table></div>';
  }
  /* ``` 코드 펜스 분리 (홀수 인덱스=코드, 닫히지 않은 펜스도 안전) */
  var segs=String(src).split('```');
  if(segs.length>1){
    var acc2='';
    for(var sgi=0;sgi<segs.length;sgi++){
      if(sgi%2===1){
        var body=segs[sgi],nl=body.indexOf('\n'),lang='',code=body;
        if(nl>=0&&nl<24&&/^[a-zA-Z0-9+#._-]*$/.test(body.slice(0,nl).trim())){ lang=body.slice(0,nl).trim(); code=body.
slice(nl+1); }
        acc2+='<div class="codeblk"><div class="ch"><span>'+gEsc(lang||'code')+'</span><button onclick="taiCodeCopy(thi
s)" aria-label="코드 복사">복사</button></div><pre><code>'+gEsc(code.replace(/\n+$/,''))+'</code></pre></div>';
      } else acc2+=taiMdCore(segs[sgi]);
    }
    return acc2;
  }
  return taiMdCore(src);
  function taiMdCore(part){
  var lines=gEsc(part).split('\n'),out=[],ul=false,tbl=[];
  function endUl(){ if(ul){ out.push('</ul>'); ul=false; } }
  function openUl(kind){ if(ul!==kind){ endUl(); out.push(kind==='n'?'<ul class="nl">':'<ul>'); ul=kind; } }
  function endTbl(){ if(tbl.length){ out.push(tblHtml(tbl)); tbl=[]; } }
  for(var i=0;i<lines.length;i++){
    var L=lines[i];
    if(/^\s*\|.+\|\s*$/.test(L)){ endUl(); tbl.push(L); continue; }
    endTbl();
    if(/^#{2,4}\s+/.test(L)){ endUl(); out.push('<h4>'+inl(L.replace(/^#{2,4}\s+/,''))+'</h4>'); continue; }
    if(/^(?:&gt;|>)\s?/.test(L)){ endUl(); out.push('<blockquote>'+inl(L.replace(/^(?:&gt;|>)\s?/,''))+'</blockquote>')
; continue; }
    if(/^\s*[-*•]\s+/.test(L)){ openUl('u'); out.push('<li>'+inl(L.replace(/^\s*[-*•]\s+/,''))+'</li>'); continue; }
    if(/^\s*\d+[.)]\s+/.test(L)){ var m=L.match(/^\s*(\d+)[.)]\s+(.*)$/); openUl('n'); out.push('<li><em class="no">'+m
[1]+'.</em>'+inl(m[2])+'</li>'); continue; }
    endUl();
    if(!L.trim()){ out.push('<div class="sp8"></div>'); continue; }
    out.push('<p>'+inl(L)+'</p>');
  }
  endUl(); endTbl();
  return out.join('');
  }
}
