.chart-card .cc-title{font-size:13px;font-weight:700}
.chart-legend{display:flex;gap:16px;font-size:11.5px;color:var(--text-3)}
.chart-legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
.metrics{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--border);border:1px solid var(--borde
r);border-radius:var(--r-lg);overflow:hidden}
.metric{background:var(--surface);padding:14px 16px}
.metric .m-k{font-size:11.5px;color:var(--text-3);font-weight:500}
.metric .m-v{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:21px;font-weight:650;margin-top:4px;let
ter-spacing:-.01em}
.metric .m-s{font-size:11px;color:var(--text-3);margin-top:2px}
/* AI panel */
.ai-panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-1)
;display:flex;flex-direction:column;align-self:start;position:sticky;top:24px;max-height:calc(100vh - 104px)}
.ai-panel-head{padding:16px 20px 0;flex-shrink:0}
.ai-panel-head .ap-label{font-size:11.5px;font-weight:600;color:var(--text-3)}
.ai-panel-body{padding:12px 20px;overflow-y:auto;display:flex;flex-direction:column;gap:14px}
.ai-say{font-size:13.5px;line-height:1.7}
.ai-say b{font-weight:700}
.ai-say .hl-gain{color:var(--gain);font-weight:700}
.ai-say .hl-loss{color:var(--loss);font-weight:700}
.ai-panel-foot{padding:12px 16px 16px;border-top:1px solid var(--border);flex-shrink:0}
.ai-panel-foot .ap-input{display:flex;gap:8px;border:1px solid var(--border-strong);border-radius:var(--r-md);padding:4
px 4px 4px 12px;margin-top:10px}
.ai-panel-foot .ap-input:focus-within{border-color:var(--accent-border)}
.ai-panel-foot input{flex:1;border:none;outline:none;background:transparent;font-size:13px;min-width:0}
.compare-strip{display:flex;align-items:center;gap:10px;background:var(--surface-2);border-radius:var(--r-md);padding:1
0px 14px;font-size:12.5px}
.compare-strip .cs-delta{font-family:var(--num);font-weight:700}

