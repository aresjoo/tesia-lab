82:export default {
83:  async fetch(req, env, ctx) {
84:    const url = new URL(req.url);
85:    const c = cors(req.headers.get("Origin"));
86:    if (req.method === "OPTIONS") return new Response(null, { status: 204, headers: c.h });
87:    if (url.pathname === "/api/ping") return json({ ok: !!env.ANTHROPIC_API_KEY }, c.h);
88:    if (url.pathname === "/api/ohlc") return ohlc(url, c.h);
89:    if (url.pathname !== "/api/chat" || req.method !== "POST") return new Response("not found", { status: 404, heade
rs: c.h });
90:
91:    if (!c.ok) return new Response("forbidden", { status: 403, headers: c.h });
92:    const ip = req.headers.get("CF-Connecting-IP") || "?";
93:    if (!burstOk(ip)) return new Response("rate limited", { status: 429, headers: c.h });
94:    if (!(await dailyOk(env))) return new Response("daily cap", { status: 429, headers: c.h });
95:
96:    let payload;
97:    try { payload = await req.json(); } catch (e) { return new Response(null, { status: 400, headers: c.h }); }
98:    const messages = (Array.isArray(payload.messages) ? payload.messages : [])
99:      .filter((m) => (m.role === "user" || m.role === "assistant") && typeof m.content === "string" && m.content)
100:      .slice(-16);
101:    if (!messages.length) return new Response(null, { status: 400, headers: c.h });
102:    if (!env.ANTHROPIC_API_KEY) return new Response(null, { status: 503, headers: c.h });
103:
104:    const { readable, writable } = new TransformStream();
105:    const w = writable.getWriter();
106:    const enc = new TextEncoder();
107:    const send = (o) => w.write(enc.encode("data: " + JSON.stringify(o) + "\n\n")).catch(() => {});
108:    const client = new Anthropic({ apiKey: env.ANTHROPIC_API_KEY });
109:    ctx.waitUntil((async () => {
110:      try {
111:        const isThink = payload.think === true;
112:        const stream = isThink ? client.beta.messages.stream({
113:          model: env.TETH_THINK_MODEL || "claude-haiku-4-5-20251001",
114:          max_tokens: 1024,
115:          system: String(payload.system || "").slice(0, 4000),
116:          messages,
117:        }) : client.beta.messages.stream({
118:          model: env.TETH_AI_MODEL || MODEL_DEFAULT,
119:          max_tokens: 16000,
120:          thinking: { type: "adaptive" },
121:          output_config: { effort: env.TETH_AI_EFFORT || EFFORT_DEFAULT },
122:          tools: [
123:            { type: "web_search_20260209", name: "web_search" },
124:            { type: "web_fetch_20260209", name: "web_fetch" },
125:          ],
126:          betas: ["server-side-fallback-2026-07-01"],
127:          fallbacks: "default",
128:          system: String(payload.system || "").slice(0, 8000),
129:          messages,
130:        });
131:        stream.on("text", (delta) => send({ text: delta }));
132:        /* 실작업 이벤트: 검색/페이지/코드 실행 툴 + 사고 스트림 + 누적 출력 토큰 전달 (index.mjs와 동일 프로토콜) */
133:        const blocks = {};
134:        stream.on("streamEvent", (ev) => {
135:          try {
136:            if (ev.type === "content_block_start") {
137:              const cb = ev.content_block || {};
138:              if (cb.type === "server_tool_use") blocks[ev.index] = { kind: cb.name, json: "", seed: cb.input && Ob
ject.keys(cb.input).length ? cb.input : null };
139:              else if (cb.type === "web_search_tool_result") {
140:                const ok = Array.isArray(cb.content);
141:                const rs = ok ? cb.content.filter((r) => r && r.url).map((r) => ({ t: r.title || r.url, u: r.url })
) : [];
142:                send({ sres: { n: rs.length, results: rs.slice(0, 8), error: ok ? undefined : true } });
143:              } else if (cb.type === "web_fetch_tool_result") {
144:                const c = cb.content || {};
145:                const err = c.type === "web_fetch_tool_error";
146:                send({ fres: { u: (c.content && c.content.url) || c.url || "", error: err ? (c.error_code || true) 
: undefined } });
147:              } else if (/_tool_result$/.test(cb.type || "")) {
148:                send({ tres: { kind: cb.type, error: cb.content && cb.content.type && /error/.test(cb.content.type)
 ? true : undefined } });
149:              }
150:            } else if (ev.type === "content_block_delta" && ev.delta) {
151:              if (ev.delta.type === "thinking_delta" && ev.delta.thinking) send({ think: ev.delta.thinking });
152:              else if (ev.delta.type === "input_json_delta" && blocks[ev.index] != null) blocks[ev.index].json += e
v.delta.partial_json || "";
153:            } else if (ev.type === "content_block_stop" && blocks[ev.index] != null) {
154:              const b = blocks[ev.index]; delete blocks[ev.index];
155:              let input = b.seed || {}; try { const p = JSON.parse(b.json || "{}"); if (Object.keys(p).length) inpu
t = p; } catch (e) {}
156:              send({ tool: { name: b.kind, q: input.query || input.url || (typeof input.code === "string" ? input.c
ode.slice(0, 120) : "") } });
157:            } else if (ev.type === "message_delta" && ev.usage && ev.usage.output_tokens) send({ tok: ev.usage.outp
ut_tokens });
158:          } catch (e) {}
159:        });
160:        const final = await stream.finalMessage();
161:        if (final.stop_reason === "refusal") await send({ text: "이 질문에는 답변드리기 어렵습니다. 전략이나 검증 결과에 대해 물어봐 주세요." });
162:        await send({ done: true, usage: final.usage ? { in: final.usage.input_tokens, out: final.usage.output_token
s } : undefined });
163:      } catch (e) {
164:        await send({ error: true });
165:      } finally {
166:        try { await w.close(); } catch (e) {}
167:      }
168:    })());
169:    return new Response(readable, { headers: { ...c.h, "Content-Type": "text/event-stream", "Cache-Control": "no-ca
che" } });
170:  },
171:};
1:/* TETH AI 프록시 공개 터널 (계정 불필요, localhost.run)
2: * 실행:  cd server && node tunnel.mjs   (프록시 index.mjs가 8799에서 떠 있어야 함)
3: * 하는 일: ssh 터널을 유지하고, 발급된 https URL이 바뀔 때마다
4: *          저장소 proxy-url 브랜치의 PROXY_URL 파일에 기록한다(gh CLI 사용).
5: *          배포된 사이트는 부팅 시 그 파일을 읽어 AI 프록시에 연결한다. */
6:import { spawn, execFileSync } from "node:child_process";
7:
8:const REPO = "aresjoo/tesia-lab";
9:const BRANCH = "proxy-url";
10:const FILE = "PROXY_URL";
11:let current = "";
12:
13:function ghJson(args) {
14:  try { return JSON.parse(execFileSync("gh", args, { encoding: "utf8" })); } catch (e) { return null; }
15:}
16:function publish(url) {
17:  if (url === current) return;
18:  try {
19:    const meta = ghJson(["api", `repos/${REPO}/contents/${FILE}?ref=${BRANCH}`]);
20:    const args = ["api", "-X", "PUT", `repos/${REPO}/contents/${FILE}`,
21:      "-f", `message=tunnel: ${url}`,
22:      "-f", `content=${Buffer.from(url + "\n").toString("base64")}`,
23:      "-f", `branch=${BRANCH}`];
24:    if (meta && meta.sha) args.push("-f", `sha=${meta.sha}`);
25:    execFileSync("gh", args, { encoding: "utf8" });
26:    current = url;
27:    console.log(new Date().toISOString(), "pointer updated →", url);
28:  } catch (e) {
29:    console.error("pointer update failed:", e.message);
30:  }
31:}
32:function run() {
33:  console.log(new Date().toISOString(), "opening tunnel...");
34:  const ssh = spawn("ssh", [
35:    "-o", "StrictHostKeyChecking=accept-new",
36:    "-o", "ServerAliveInterval=30",
37:    "-o", "ServerAliveCountMax=3",
38:    "-o", "ExitOnForwardFailure=yes",
39:    "-R", "80:localhost:8799",
40:    "nokey@localhost.run",
41:  ]);
42:  const onData = (d) => {
43:    const m = String(d).match(/https:\/\/[a-z0-9]+\.lhr\.life/);
44:    if (m) publish(m[0]);
45:  };
46:  ssh.stdout.on("data", onData);
47:  ssh.stderr.on("data", onData);
48:  ssh.on("close", (code) => {
49:    console.log(new Date().toISOString(), "tunnel closed (" + code + "), retrying in 5s");
50:    setTimeout(run, 5000);
51:  });
52:}
53:run();
