12628:/* 거래량 비례 실시간 충전 — 체결 파이프라인 훅. cap 초과분은 소멸 기록 (질문 2 임시) */
12629:function bcVolumeCharge(fid,ex,market,notional){
12630:  if(!tfNFInit().uidLinked) return 0; /* 거래량 충전은 UID 연동 등급 전용 — 호출부 가드와 별개의 엔진 가드 */
12631:  var cfg=bcCfg(), tbl=cfg.VOLUME_TO_CREDIT_RATE||{};
12632:  var rate=(tbl[ex]&&tbl[ex][market||'spot'])||(tbl.binance&&tbl.binance.spot)||0;
12633:  var credit=Math.round(notional*rate);
12634:  if(credit<=0) return 0;
12635:  /* cap 은 당월 거래량 충전 누계 기준 — 총 잔액 기준이면 카드 월 충전(캡 초과)이 거래량 충전을 영구 차단한다 (질문 2 임시) */
12636:  var used=bcMonthVol(), cap=cfg.UID_CREDIT_CAP||Infinity;
12637:  var expire=0;
12638:  if(used+credit>cap){ expire=used+credit-cap; credit=Math.max(0,cap-used); }
12639:  if(credit>0){
12640:    if(!bcAppend('charge','volume',credit,fid,'vol:'+fid)) return 0; /* fid 멱등 */
12641:    if(expire>0) bcEvent('cap-expire',{fid:fid,expired:expire});
12642:    bcAfterChange('volume'); /* 관망 복구 트리거 포함 (질문 5 임시: 거래량 충전도 복구) */
12643:  } else if(expire>0&&bcAppend('charge','volume',0,fid,'vol:'+fid)){ bcEvent('cap-expire',{fid:fid,expired:expire}); }
12644:  return credit;
12645:}
12646:/* 자유형 AI 사용 차감 — 0 하한, 부족분 미차감. 0 도달/차단 판정은 bcAfterChange 의 grace/watch 전이가 담당 (질문 10 임시) */
12647:function bcAiDebit(reqId){
