12724:    return;
12725:  }
12726:  if(trigger==='watch')
12727:    tfNotify('bill','bill.watch:'+day, L('bill.watch.t'), L('bill.watch.b'), '#/plan');
12728:  var br=bcBranch();
12729:  tfNotify('bill','bill.'+br+':'+day, L('bill.'+br+'.t'), L('bill.'+br+'.b'), '#/plan');
12730:  if(br==='uid.heavy') bcEvent('rescue-offer',{day:day}); /* 90% 할인 제안 노출 기록 */
