10413:  var slP='₩'+Math.round(px*(1+p.sl/100)).toLocaleString();
10414:  var tpP=p.tp!=null?'₩'+Math.round(px*(1+p.tp/100)).toLocaleString():null;
10415:  var rp=rsi(PRICE,ev.i-1);
10416:  if(ev.k==='scan'){ var m=tfTmMkt(s,ev.i);
10417:    return gEsc('방금 시장 데이터를 새로 확인했습니다. 거래량이 20봉 평균보다 '+(m.volChg>=0?'+':'')+m.volChg+'% '+(m.volChg>=0?'늘었고':'줄었고')+', 이평은 '+(m.up?'정배열이라 환경은 나쁘지 않아요':'역배열이라 서두를 이유가 없어요')+'. 다만 제 진입 기준(RSI '+p.rsiTh+' 이하)에는 아직 미달이라 총알을 아끼고 기다립니다.'); }
10418:  if(ev.k==='entry') return gEsc('저는 지금 '+s.asset+' 반등에 올라탑니다. RSI가 '+p.rsiTh+' 아래로 눌렸다가 오늘 반등이 확인돼서 좋은 자리라고 봤어요. '+(tpP?'목표가는 '+tpP+', ':'')+'손절은 '+slP+'에 걸어뒀으니 틀려도 손실은 계획 안에서 끝납니다.');
10419:  if(ev.k==='exit-sl') return gEsc('손절 라인에 닿아서 미련 없이 정리했습니다. 손실은 계획했던 '+p.sl+'% 안에서 끝났고, 자금을 지켰으니 다음 기회를 노립니다.');
10420:  if(ev.k==='exit-tp') return gEsc('목표가에 도달해서 전량 익절했습니다. 계획했던 +'+p.tp+'%를 그대로 챙겼고, 이제 다음 진입 신호를 기다립니다.');
10421:  if(ev.k==='exit-time') return gEsc('25봉 동안 결판이 안 나서 규칙대로 정리했습니다. 추세가 사라진 자리에 돈을 묶어두지 않는 것이 제 원칙이에요.');
10422:  if(ev.k==='risk') return gEsc('포지션은 그대로 들고 갑니다. 추세가 아직 제 편이고, 손절 '+p.sl+'%'+(p.tp!=null?'와 익절 +'+p.tp+'%':'')+' 라인 어느 쪽에도 닿지 않았거든요. 규칙대로 매 봉 점검만 계속합니다.');
10423:  return gEsc('이번 봉은 쉬어갑니다. RSI가 '+rp.toFixed(1)+'이라 제 기준('+p.rsiTh+' 이하)까지 내려오지 않았거든요. 조건이 맞을 때까지 무리해서 들어가지 않겠습니다.');
10424:}
