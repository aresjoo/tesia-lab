12572:/* ── §9.7 크레딧, 알림, 정산, 트레이딩 확장 (nf) — 시트 요구사항, phase6-reconciliation 계약.
12573:   원칙: 기존 UI 불변(EXTEND 지점만 훅), 모든 수치 실계산, 시뮬레이션 명시, 상태 전이 커밋 시에만 이벤트 생성. ── */
12574:var TF_ONNF=false;
13028:function tfRebateCommit(botId,fills,budget){
13029:  var t=tfNFInit(); var sum=0;
13030:  fills.forEach(function(f){
13031:    if(!f.fid) return;
13032:    if(t.rebates.some(function(r){ return r.fid===f.fid; })) return;
13033:    var fee=budget*0.002; /* 기존 엔진 수수료율 재사용 */
13034:    var amt=Math.round(fee*TFC.rebate.rate);
13035:    t.rebates.push({fid:f.fid,botId:botId,amt:amt,at:f.at,sim:true});
13036:    if(t.uidLinked&&typeof bcVolumeCharge==='function'){ /* UID 등급: 거래량 비례 실시간 충전 (3단계) */
13037:      var bot=(t.strat||[]).filter(function(x){return String(x.at)===String(botId);})[0];
13038:      bcVolumeCharge(f.fid,(bot&&bot.ex)||(t.ob&&t.ob.ex)||'binance',(bot&&bot.mkt==='선물')?'futures':'spot',budget);
13039:    }
13040:    sum+=amt;
13041:  });
13042:  if(sum>0&&t.notifPrefs.rebate) tfNotify('rebate','rb:'+botId,'수수료 적립 +'+tfWon(sum)+' (시뮬레이션)','거래 수수료의 10%가 적립됐어요. 적립 내역은 PLAN 정산 탭에서 확인할 수 있어요.','#/plan/rebates'); /* 수신 설정 반영 (codex NF P1) */
13043:  return sum;
13044:}
13045:/* ── 거래복기: 체결 이벤트 커밋 시 1회 생성 (eventId dedup) — 엔진 실존 신호만 인용 ── */
13046:function tfReviewCommit(botId,f,p,asset,budget){
13047:  var t=tfNFInit();
13048:  var rid='rv'+f.fid;
13049:  if(t.reviewKeys[rid]) return; /* 처리 키 원장 — 60개 캡 밀림 후에도 재생성 금지 (codex NF P1) */
13050:  t.reviewKeys[rid]=1;
13051:  var kindL={sl:'손절',tp:'익절',time:'기간 청산'}[f.kind]||'청산';
13052:  var won=f.pnl>=0;
13053:  var causes=[];
13054:  if(won){
13055:    causes.push(['진입 근거','RSI '+p.rsiTh+' 이하로 눌린 뒤 전일 대비 +0.5% 반등이 확인된 봉에서 진입했어요.'+(p.trendFilter?' 추세 필터(20일/60일 이평 괴리)가 통과된 구간이었어요.':'')]);
13056:    /* 청산 사유는 엔진이 기록한 kind 만 인용 — 추정 문구 금지 (codex NF P1) */
13057:    causes.push(['청산 근거',f.kind==='tp'?'설정한 익절 목표 +'+p.tp+'% 에 도달해 규칙대로 청산했어요.':f.kind==='time'?'보유 25일 경과로 기간 청산 규칙이 실행됐어요.':'설정한 청산 규칙이 실행됐어요.']);
13058:    causes.push(['다음 제안','같은 조건이 유지되면 규칙을 바꾸지 않는 것이 검증 결과와 일치해요.']);
13059:  }else{
13060:    causes.push(['손실 원인','진입 후 반등이 이어지지 못하고 가격이 손절선 '+p.sl+'% 에 먼저 닿았어요. 손절 규칙이 작동해 손실을 '+(f.pnl*100).toFixed(1)+'% 로 제한했어요.']);
13061:    causes.push(['규칙 평가','손절 규칙이 설정된 폭 안에서 그대로 작동한 거래예요.']);
13062:    causes.push(['다음 제안','진입 조건(RSI '+p.rsiTh+')과 손절 폭은 검증 화면에서 다시 조정해 재검증할 수 있어요.']);
13063:  }
13064:  t.reviews.unshift({id:rid,fid:f.fid,botId:botId,asset:asset,kind:f.kind,kindL:kindL,pnl:f.pnl,at:f.at,budget:budget,causes:causes,sim:true});
13065:  if(t.reviews.length>60) t.reviews=t.reviews.slice(0,60);
13066:  if(t.notifPrefs.review)
13067:    tfNotify('review','nrv:'+f.fid,asset+' '+kindL+' 복기 리포트 도착',(won?'왜 수익이 났는지':'왜 손실이 났는지')+' 원인을 분석했어요. ('+(f.pnl>=0?'+':'')+(f.pnl*100).toFixed(1)+'%, 시뮬레이션)','#/review/'+rid);
13068:}
13069:/* 주간/월간: 기간 종료 후 첫 실행 시 생성 (codex 계약) */
13070:function tfPeriodicCheck(){
13071:  var t=tfNFInit();
13072:  if(!t.reviews.length&&!t.rebates.length) return;
13073:  var now=new Date();
13074:  var weekStart=new Date(now); weekStart.setDate(now.getDate()-((now.getDay()+6)%7)); weekStart.setHours(0,0,0,0);
13075:  var monthStart=new Date(now.getFullYear(),now.getMonth(),1);
13076:  var prevMonthStart=new Date(now.getFullYear(),now.getMonth()-1,1).getTime();
13077:  /* [기간 시작, 기간 종료) 범위 집계 — 전체 과거 누적 재집계 금지 (codex NF P1) */
13078:  [['W',weekStart.getTime()-7*864e5,weekStart.getTime(),'주간'],['M',prevMonthStart,monthStart.getTime(),'월간']].forEach(function(cfg){
13079:    var kind=cfg[0], from=cfg[1], boundary=cfg[2], label=cfg[3];
13080:    var evs=t.reviews.filter(function(r){ return r.at>=from&&r.at<boundary; });
13081:    if(!evs.length) return;
13082:    var pid=kind+':'+new Date(boundary-1).toISOString().slice(0,10);
13083:    if(t.periodics.some(function(p){ return p.id===pid; })) return;
13084:    var wins=evs.filter(function(r){return r.pnl>0;}).length;
13085:    var pnl=evs.reduce(function(a,r){return a+r.pnl;},0);
13086:    var rb=t.rebates.filter(function(r){ return r.at>=from&&r.at<boundary; }).reduce(function(a,r){return a+r.amt;},0);
13087:    t.periodics.unshift({id:pid,kind:kind,label:label,from:from,until:boundary,n:evs.length,wins:wins,pnl:pnl,rebate:rb,sim:true,at:Date.now()});
13088:    tfNotify('report','npd:'+pid,label+' 성과 보고서가 도착했어요',evs.length+'건의 체결을 요약했어요. (시뮬레이션)','#/periodic/'+pid);
13089:  });
13090:  tfSave();
13091:}
