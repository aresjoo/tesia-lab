11382:/* 파생 계산 단일 함수 — 서머리/카드/상세가 전부 이걸 쓴다 (수치 불일치 구조적 차단).
11383:   데모: 카피 시작을 시뮬레이션 30봉 전으로 간주 (실서버: 실시간 체결 스트림) */
11384:function cpCalc(c2){
11385:  var s2=tfSSFind(c2.nick), m=s2?cpMeta(c2.nick):null;
11386:  var inv=c2.ledger.reduce(function(a,e){ return a+(e.type==='add'?e.amt:-e.amt); },0);
11387:  if(!s2||!s2.r.eq||s2.r.eq.length<32) return {inv:inv,pnlPct:0,total:0,realized:0,unreal:0,share:0,net:0,est:inv,avail:inv,posOpen:false};
11388:  var eq=s2.r.eq;
11389:  var startI=c2.simStartI!=null?c2.simStartI:eq[eq.length-31].i;
11390:  var e0=null,e1=eq[eq.length-1];
11391:  for(var k=0;k<eq.length;k++){ if(eq[k].i>=startI){ e0=eq[k]; break; } }
11392:  if(!e0) e0=eq[0];
11393:  if(c2.flatI!=null){ /* 수동 정리: 손익 구간을 정리 시점에서 고정 (성역 — 이후 트레이더 손익은 미반영, 다음 진입 대기) */
11394:    for(var k2=eq.length-1;k2>=0;k2--){ if(eq[k2].i<=c2.flatI){ e1=eq[k2]; break; } }
11395:  }
11396:  var pnlPct=e1.v/e0.v-1;
11397:  var total=c2.amount*pnlPct; /* 증액분은 다음 진입부터 반영 — 데모 단순화: 초기 금액 기준 */
11398:  var closed=(s2.r.trades||[]).filter(function(x){ var e=(x.exit!=null?x.exit:x.entry); return e>=startI&&(c2.flatI==null||e<=c2.flatI); });
11399:  /* 실현손익 = 마지막 청산 시점의 곡선값 기준 — 총손익과 같은 척도라 산식 차이가 가상 포지션을
11400:     만들지 않는다. 미실현 = 마지막 청산 이후 구간의 변화만 (codex P1-5 근본 수정) */
11401:  var lastX=-1; closed.forEach(function(x){ var e=(x.exit!=null?x.exit:x.entry); if(e>lastX) lastX=e; });
11402:  var eLast=e0;
11403:  if(lastX>=0){ for(var k3=eq.length-1;k3>=0;k3--){ if(eq[k3].i<=lastX){ eLast=eq[k3]; break; } } }
11404:  var realized=lastX>=0?c2.amount*(eLast.v/e0.v-1):0;
11405:  var unreal=total-realized;
11406:  if(c2.flatI!=null){ realized=total; unreal=0; } /* 수동 정리: 미실현을 실현으로 확정 */
11407:  var share=Math.max(0,realized)*(m?m.share:0.1);
11408:  var net=total-share;
11409:  var posOpen=Math.abs(unreal)>c2.amount*0.002;
11410:  var est=inv+net;
11411:  var avail=Math.max(0,est-(posOpen?c2.amount*0.4:0));
11412:  return {inv:inv,pnlPct:pnlPct,total:total,realized:realized,unreal:unreal,share:share,net:net,est:est,avail:avail,posOpen:posOpen,closedN:closed.length};
11413:}
