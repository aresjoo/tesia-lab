12759:/* ═══ 정산 배치 (6단계): 월 사이클, 상쇄, dunning, 일 재대사 ═══
12760:   금액 계산은 전부 이벤트(운영 데이터)로만 기록 — 유저 UI 비노출 정책 유지 */
12761:/* 사이클 청구액: 플랜가 x (1 - min(1, 당월 거래량 충전/월 충전량)), 하한 0 (질문 4 임시).
12762:   미사용 rescue90 쿠폰이 있으면 다음 1회분에 적용 (질문 8 임시) */
12763:function bcBillQuote(){
12764:  var cfg=bcCfg();
12765:  var offset=Math.min(1,bcMonthVol()/(cfg.CARD_CREDIT_MONTHLY||1));
12766:  var gross=cfg.CARD_PLAN_PRICE_USD||0;
12767:  var net=Math.max(0,gross*(1-offset));
12768:  var b=bcInit(), cp=null;
12769:  if(net>0){ /* 청구액 0 이면 쿠폰을 소진하지 않는다 — 낭비 방지 */
12770:    for(var i2=0;i2<b.coupons.length;i2++){ if(!b.coupons[i2].usedAt){ cp=b.coupons[i2]; break; } }
12771:    if(cp) net=Math.max(0,net*(1-(cp.rate||0)));
12772:  }
12773:  return {gross:gross,offset:offset,net:Math.round(net*100)/100,coupon:cp?cp.id:null};
12774:}
12775:/* 결제 시뮬 — 데모: b.simPayFail 로 실패 주입. 실서버 PG 연동 지점 */
12776:function bcPayAttempt(q){ return !bcInit().simPayFail; }
12777:/* 월말 초기화: 카드 충전분 잔여만 소멸 (이월 없음). 거래량분은 무기한 (질문 3 임시).
