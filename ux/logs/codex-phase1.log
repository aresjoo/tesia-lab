10914:    +'<button class="nfx-btn out" style="padding:6px 12px;font-size:12px" onclick="tfNav(&quot;#/plan/alerts&quot;)">수신 설정</button></div></div>'
10915:    +'<div class="nfxh-fchips">'+TB.map(function(tb){ var c=t.notifs.filter(function(n){return inTab(n,tb[0]);}).length;
10916:      return '<button class="nfxh-fchip'+(NF_TAB===tb[0]?' on':'')+'" onclick="NF_TAB=\''+tb[0]+'\';tfNFAlertsRender()">'+tb[1]+(c?'<span class="c2">'+c+'</span>':'')+'</button>'; }).join('')+'</div>'
10917:    +'<div class="nfxh-alerts-list">'+(rows.length?rows.map(function(n){
10918:      var tg={credit:'크레딧',pos:'포지션',bot:'전략',review:'거래복기',rebate:'정산',report:'보고서'}[n.type]||n.type;
10919:      var mv=''; var m1=n.title.match(/([+-]\d+(?:\.\d+)?)%/); var m2=n.title.match(/\+₩([\d,]+)/);
10920:      if(m1) mv='<span class="mv '+(m1[1].charAt(0)==='+'?'up':'dn')+'">'+m1[1]+'%</span>';
10921:      else if(m2) mv='<span class="mv up">+₩'+m2[1]+'</span>';
10922:      return '<div class="nf-item'+(n.read?' read':'')+'" onclick="tfNotifGo(\''+n.id+'\')"><span class="ic"></span><div class="bx">'
10923:        +'<div class="tt" style="display:flex;align-items:flex-start"><span style="flex:1;min-width:0"><span class="tg t-'+n.type+'">'+tg+'</span>'+gEsc(n.title)+'</span>'+mv+'</div>'
10924:        +(n.body?'<div class="bd2">'+gEsc(n.body)+'</div>':'')
