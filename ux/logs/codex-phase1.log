12611:  if(!Array.isArray(b.coupons)) b.coupons=[];     /* {id,kind,at,usedAt} — 수령 이력 조회용 */
12612:  if(!Array.isArray(b.events)) b.events=[];       /* {at,key,data} — 임계/전환/복구 분포 분석용 */
12613:  if(!b.mode) b.mode='active';                    /* active | grace | watch */
12614:  if(b.graceAt===undefined) b.graceAt=null;
12615:  if(b.cardOn===undefined) b.cardOn=false;
12616:  if(b.cycleAt===undefined) b.cycleAt=null;       /* 다음 월 결제 시각 (질문 9 임시: 결제일 앵커) */
12617:  if(b.cardFails===undefined) b.cardFails=0;      /* dunning 재시도 카운터 */
12618:  return b;
12619:}
