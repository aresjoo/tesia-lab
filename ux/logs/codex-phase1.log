9900:function tfCnApi(){
9901:  var t=tfS(),k=$('tfcn-k'),s=$('tfcn-s'),ok=true;
9902:  [[k,10],[s,10]].forEach(function(x){ var bad=!x[0]||x[0].value.trim().length<x[1]; if(x[0]) x[0].closest('.tf-fld').classList.toggle('bad',bad); if(bad) ok=false; });
9903:  var pp=$('tfcn-p'); if(pp){ var bad=pp.value.trim().length<1; pp.closest('.tf-fld').classList.toggle('bad',bad); if(bad) ok=false; } /* OKX passphrase 필수 */
9904:  if(!ok) return;
9905:  var go=$('tfcn-apigo'); if(go) go.disabled=true;
9906:  var kv=k.value.trim();
9907:  var msgs=['읽기 권한 확인 중...','거래 권한 확인 중...','출금 권한 없음 확인 중...'],mi=0;
9908:  var tick=setInterval(function(){ if(go&&mi<msgs.length) go.textContent=msgs[mi++]; },650);
9909:  var ppv=pp?pp.value.trim():null; /* okx passphrase — 존재 검사만 하고 버리던 결함 수정, 원문은 저장하지 않는다 (codex QA2 P2) */
9910:  var ex0=t.ob.ex; /* 요청 시점 거래소 캡처 — 대기 중 거래소를 바꾸면 늦은 응답 폐기 (codex qa3 P0-2) */
9911:  TF_ADAPTER.verifyApi(t.ob.ex,kv,s.value.trim(),function(err){
9912:    clearInterval(tick);
9913:    if(t.ob.ex!==ex0){ return; } /* 다른 거래소로 전환된 뒤 도착한 응답 — 무시 */
9914:    if(err&&err.code==='missing_passphrase'){ t.ob.err='Passphrase를 확인해주세요. OKX는 API 생성 시 설정한 Passphrase가 필요해요.'; tfSave(); tfConnectView(); return; }
9915:    if(err){ t.ob.err='API Key 권한 확인에 실패했어요. 읽기와 거래 권한이 켜져 있는지 확인해주세요.'; tfSave(); tfConnectView(); return; }
9916:    t.ob.st='api_verified'; t.ob.err=null;
9917:    t.api={ex:t.ob.ex,last4:kv.slice(-4)}; /* 키 원문은 저장하지 않는다 */
9918:    tfSave();
9919:    tfNav('#/strategy/connect'); /* 4단계 분기 경유 — 복귀 대상 봇(TF_NF_RESUME)이 있으면 done 대신 그 봇 시작 (codex NF P0-3) */
9920:  },ppv);
9921:}
