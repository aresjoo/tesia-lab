12662:/* 임계 판정 + 모드 전이. 모수 = max(당월 총 유입, 웰컴) (질문 6 임시) */
12663:function bcWarnBase(){ var cfg=bcCfg(); return Math.max(bcMonthInflow(), cfg.WELCOME_CREDIT||1); }
12664:function bcAfterChange(src){
