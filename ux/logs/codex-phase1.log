9563:/* ── §3 TETH 점수 ── */
9564:function tfScore(res){
9565:  var c=TFC.score;
9566:  function nz(v,lo,hi){ var x=(v-lo)/(hi-lo); return Math.max(0,Math.min(1,x)); }
9567:  var sc=nz(res.winRate,c.winLo,c.winHi)*c.wWin
9568:       +nz(res.cagr,c.retLo,c.retHi)*c.wRet
9569:       +nz(res.mdd,c.mddLo,c.mddHi)*c.wMdd
9570:       +nz(res.tradeVol,c.volLo,c.volHi)*c.wVol;
9571:  sc*=100;
9572:  if(res.n<4) sc*=0.65; /* 표본 부족 페널티 */
9573:  if(res.n<6) sc=Math.min(sc,79); /* 표본이 너무 적으면 실행 기준을 넘지 못하게 상한 (P0-05) */
9574:  return Math.max(5,Math.min(99,Math.round(sc)));
9575:}
