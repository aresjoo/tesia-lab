8400:       먼저 도착하면 ReferenceError로 복원이 결손되던 로드 레이스 (fullqa) */
8401:    function ready(p){ if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',function(){ cb(p); }); } else cb(p); }
