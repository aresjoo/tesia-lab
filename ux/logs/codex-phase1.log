10928:      :'<div class="nfx-empty"><div class="nfx-eicon">'+NFX_IC.bell+'</div><div class="nfx-etit">아직 알림이 없어요</div><div class="nfx-edesc">전략이 실행되면 체결, 복기, 정산 소식이 여기로 와요.</div></div>'))+'</div>';
10929:  ['d','m'].forEach(function(sfx){ var el=$('nfxh-ct-alerts-'+sfx); if(el){ if(unread) el.textContent=unread; else el.remove(); } });
