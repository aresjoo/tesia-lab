9634:/* 실체결 마커 캔버스: 검증 구간 가격 곡선 위에 ▲매수 ▼매도 순차 드로잉 */
9635:function tfMarkers(cvId,cur){
9636:  var cv=$(cvId); if(!cv) return;
9637:  var cx=cv.getContext('2d'),d=Math.min(devicePixelRatio||1,2);
9638:  var r=cv.getBoundingClientRect(); cv.width=r.width*d; cv.height=r.height*d; cx.setTransform(d,0,0,d,0,0);
9639:  var W=r.width,H=r.height;
9640:  var a=cur.startI,b=cur.endI,n=b-a;
9641:  var lo=1e18,hi=-1e18;
9642:  for(var i=a;i<=b;i++){ if(PRICE[i]<lo) lo=PRICE[i]; if(PRICE[i]>hi) hi=PRICE[i]; }
9643:  var pad=(hi-lo)*.12; hi+=pad; lo-=pad;
9644:  var X=function(i){ return (i-a)/n*(W-14)+7; }, Y=function(v){ return H-8-(v-lo)/(hi-lo)*(H-16); };
9645:  var t0=performance.now(),DUR=1500,MDUR=1800;
9646:  var tr=cur.trades||[];
9647:  (function draw(now){
9648:    if(!cv.isConnected) return;
9649:    var q=Math.min(1,(now-t0)/DUR);
9650:    cx.clearRect(0,0,W,H);
9651:    cx.strokeStyle='rgba(143,178,255,.75)'; cx.lineWidth=1.5; cx.beginPath();
9652:    var upto=a+Math.floor(n*q);
9653:    for(var i=a;i<=upto;i++){ var x=X(i),y=Y(PRICE[i]); i===a?cx.moveTo(x,y):cx.lineTo(x,y); }
9654:    cx.stroke();
9655:    /* 마커: 곡선이 지나간 지점부터 순차 등장 */
9656:    var mq=Math.min(1,(now-t0)/MDUR);
9657:    cx.font='700 10px Geist,sans-serif'; cx.textAlign='center';
9658:    tr.forEach(function(t2,ti){
9659:      var show=(ti+1)/tr.length<=mq*1.15;
9660:      if(!show) return;
9661:      if(t2.e>=a&&t2.e<=upto){ cx.fillStyle='#56c486'; cx.beginPath(); var ex=X(t2.e),ey=Y(PRICE[t2.e])+11; cx.moveTo(ex,ey-6); cx.lineTo(ex-4.5,ey); cx.lineTo(ex+4.5,ey); cx.closePath(); cx.fill(); }
9662:      if(t2.x>=a&&t2.x<=upto){ cx.fillStyle='#ee766a'; cx.beginPath(); var xx=X(t2.x),xy=Y(PRICE[t2.x])-11; cx.moveTo(xx,xy+6); cx.lineTo(xx-4.5,xy); cx.lineTo(xx+4.5,xy); cx.closePath(); cx.fill(); }
9663:    });
9664:    if(q<1||mq<1) requestAnimationFrame(draw);
9665:  })(t0);
9666:}
