9785:  var exp=$('tfp-exp'); if(exp) exp.addEventListener('input',function(){ var v=this.value.replace(/[^\d]/g,''); this.value=v.length>2?v.slice(0,2)+'/'+v.slice(2,4):v; });
9786:}
9787:function tfPayCardNext(){
9788:  var ok=true;
9789:  function chk(id,test){ var f=$(id); var bad=!test(f.value.trim()); f.closest('.tf-fld').classList.toggle('bad',bad); if(bad) ok=false; }
9790:  chk('tfp-num',function(v){ return v.replace(/\s/g,'').length===16; });
9791:  chk('tfp-exp',function(v){ return /^\d{2}\/\d{2}$/.test(v); });
9792:  chk('tfp-cvc',function(v){ return /^\d{3}$/.test(v); });
9793:  chk('tfp-nm',function(v){ return v.length>=2; });
9794:  if(!ok) return;
9795:  tfPayKeep(); tfPayStep('confirm');
9796:}
