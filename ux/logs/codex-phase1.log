12703:}
12704:function bcMonthSpend(){ /* 당월 차감 합 (양수 반환) */
12705:  var b=bcInit(), from=b.cycleAt?b.cycleAt-30*864e5:Date.now()-30*864e5;
12706:  return -b.ledger.filter(function(e){ return e.at>=from&&e.amt<0&&e.type==='debit'; }).reduce(function(a,e){ return a+e.amt; },0);
12707:}
12708:function bcBranch(){
12709:  var tier=bcTier(), cfg=bcCfg();
12710:  if(tier==='FREE') return 'free.out';
12711:  if(tier==='CARD') return 'card.out'; /* CARD 단독 월중 소진 (질문 13 임시: UID 연동 제안) */
12712:  var v=bcMonthVol(), u=bcMonthSpend();
12713:  if(v<=0) return 'uid.novol'; /* 거래량 0 은 CARD_UID 도 동일: 전략 조정 유도 */
12714:  if(tier==='CARD_UID') return 'carduid.out'; /* 카드 보유자에게 카드 제안 금지 (질문 15 임시: 결제일 재충전 안내) */
12715:  if(u>=(cfg.CARD_CREDIT_MONTHLY||3000)*0.5) return 'uid.heavy'; /* 카드 플랜급 소비 = 과다 (질문 14 임시) */
12716:  return 'uid.small';
12717:}
12718:/* 트리거: warn(경고 진입) / watch(관망 전환) / blocked(관망 중 시도) / recover(재개)
12719:   메시지는 tfNotify 재사용, 일 1회 dedup (질문 7 임시: 재경고 일 1회) — 수치/잔액 비노출 */
12720:function bcRoute(trigger){
12721:  var day=Math.floor(Date.now()/864e5);
