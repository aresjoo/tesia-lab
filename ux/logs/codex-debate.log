10053: /* 파생 계산 — 캐시. 수수료는 엔진 pnl 에 이미 반영(재차감 금지), 실현/미실현 복리 대사 (term-codex 1.3) */
10054: function tfTmCalc(s){
10055:   var p=s.p, ck=tfTmKey(p);
10056:   var c=TF_TM_C[ck];
10057:   if(!c){
10058:     var r=runBacktest(p);
10059:     var L2=tfBotLogEvents(p);
10060:     /* 열린 포지션: 마지막 미청산 진입 이벤트에서 파생 */
10061:     var openI=null;
10062:     for(var k2=L2.evs.length-1;k2>=0;k2--){ var e2=L2.evs[k2]; if(!e2) continue;
10063:       if(e2.k.indexOf('exit')===0) break;
10064:       if(e2.k==='entry'){ openI=e2.i; break; } }
10065:     c=TF_TM_C[ck]={r:r,score:tfScore(r),L:L2,openI:L2.last.inPos?openI:null};
10066:   }
10067:   var r2=c.r, cap=s.cap;
10068:   /* 복리 대사: capClosed=cap×∏(1+pnl) → realized, unreal=NAV-capClosed (term-codex 1.3) */
10069:   var capW=cap, feeEst=0, tRows=[];
10070:   r2.trades.forEach(function(tr){
10071:     feeEst+=capW*0.002;
10072:     var pk=capW*tr.pnl;
10073:     tRows.push({entry:tr.entry,exit:tr.exit,pnl:tr.pnl,kind:tr.kind,krw:pk,capB:capW});
10074:     capW*=(1+tr.pnl);
10075:   });
10076:   var nav=cap*(1+r2.ret/100);
10077:   var realized=capW-cap;
10078:   var unreal=nav-capW;
10079:   var pos=null;
10080:   if(c.openI!=null){
10081:     var ep=PRICE[c.openI], cp=PRICE[p.endI];
10082:     pos={entryI:c.openI,entryP:ep,curP:cp,qty:capW/ep,chg:cp/ep-1,krw:unreal,
10083:       stopP:ep*(1+p.sl/100),tpP:p.tp!=null?ep*(1+p.tp/100):null,bars:p.endI-c.openI};
10084:   }
10085:   return {r:r2,score:c.score,L:c.L,cap:cap,nav:nav,pnl:nav-cap,pnlPct:r2.ret,
10086:     realized:realized,unreal:unreal,feeEst:feeEst,trades:tRows,pos:pos};
10087: }
