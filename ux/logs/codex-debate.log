10404: function tfTmMkt(s,i){
10405:   var rets=[],k; for(k=Math.max(1,i-19);k<=i;k++) rets.push(PRICE[k]/PRICE[k-1]-1);
10406:   var mu=rets.reduce(function(a,b){return a+b;},0)/rets.length;
10407:   var v=Math.sqrt(rets.reduce(function(a,b){return a+(b-mu)*(b-mu);},0)/rets.length)*100;
10408:   var s20=sma(PRICE,20,i), s60=sma(PRICE,60,i);
10409:   return { vol20:v, mom5:(PRICE[i]/PRICE[Math.max(0,i-5)]-1)*100, volChg:((i*37)%80)-30, up:s20>=s60, gap:Math.abs(s20-s60)/PRICE[i]*100 };
10410: }
