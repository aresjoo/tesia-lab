11213: function cpPerf(s,days){
11214:   var r=s.r, eq=r.eq||[], m=cpMeta(s.nick);
11215:   if(!eq.length) return {roi:r.ret,pnl:0,copiersPnl:0,winRate:r.winRate||0,mdd:r.mdd,wins:0,losses:0,n:r.n,eq:[]};
11216:   var i1=eq[eq.length-1].i, cut=i1-days;
11217:   var win=eq.filter(function(e){ return e.i>=cut; });
11218:   if(win.length<2) win=eq.slice();
11219:   var roi=(win[win.length-1].v/win[0].v-1)*100;
11220:   var pnl=m.aum*roi/100;
11221:   var peak=-1e18, mdd=0;
11222:   win.forEach(function(e){ if(e.v>peak)peak=e.v; var dd2=(e.v/peak-1)*100; if(dd2<mdd)mdd=dd2; });
11223:   var tr=(r.trades||[]).filter(function(x){ return (x.exit!=null?x.exit:x.entry)>=cut; });
11224:   var wn=tr.filter(function(x){return x.pnl>0;}).length;
11225:   return { roi:roi, pnl:pnl, copiersPnl:pnl*Math.min(1.6,m.copiers/20), winRate:tr.length?wn/tr.length*100:(r.winRate||0),
11226:     mdd:Math.abs(mdd), wins:wn, losses:tr.length-wn, n:tr.length, eq:win };
11227: }
