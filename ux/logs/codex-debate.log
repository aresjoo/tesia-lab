ux/proposals/CODEX_PROPOSAL.md:110:    id = ({'high/high':8,'high/low':9,'low/high':10,'low/low':11}
ux/proposals/CODEX_PROPOSAL.md:111:      [f.usageBand+'/'+f.tradeBand] ?? null);
ux/proposals/CODEX_PROPOSAL.md:112:  }
ux/proposals/CODEX_PROPOSAL.md:113:  return {stateId:id, status:id === null ? 'unclassified' : 'ready'};
ux/proposals/CODEX_PROPOSAL.md:114:}
