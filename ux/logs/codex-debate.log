ux/proposals/CODEX_PROPOSAL.md:100:```js
ux/proposals/CODEX_PROPOSAL.md:101:function classify(f) {
ux/proposals/CODEX_PROPOSAL.md:102:  if (!f.ready) return {stateId:null, status:'reconciling'};
ux/proposals/CODEX_PROPOSAL.md:103:  if (!f.loggedIn) return {stateId:1, status:'ready'};
