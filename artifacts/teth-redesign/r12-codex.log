/* 연결 상태 — tfDerive().activation 만 읽는다. 카드/행 배지 5종: none(미연결) pending(연결 중) partial(부분 완료) done(연결됨) error(오류)
   UID 연동은 거래소 무관 데이터라 ex 가 비어 있으면 추천 거래소(Bitget) 카드가 그 상태를 받는다 */
function tfCxStatus(b,d){
