  var mine=(a.ex===b.id)||(!a.ex&&b.id==='bitget');
  if(mine&&a.uid==='done'&&a.api==='done') return {k:'done',label:b.name+' 연결됨'};
  if(t.ob&&t.ob.ex===b.id&&t.ob.err) return {k:'error',label:'오류, 다시 시도해 주세요'};
  if(mine&&(a.uid==='done'||a.api==='done')) return {k:'partial',label:'부분 완료: '+(a.uid==='done'?'요금 연동 완료, 실행 연결 필요':'실행 연결 완료, 요금 연동은 선택')};
  if(t.ob&&t.ob.ex===b.id&&/pending/.test(String(t.ob.st||''))) return {k:'pending',label:'연결 중'};
  var tabs='<div class="mk-tabs" role="tablist">'+nav.map(function(n){ return '<button type="button" role="tab" class="mk-tab'+(tab===n[0]?' on':'')+'" aria-selected="'+(tab===n[0])+'" onclick="tfShareHub(\''+n[0]+'\')">'+n[1]+'</button>'; }).join('')+'</div>';
  var controls='';
  if(tab==='find'){
    var pd=mkPd(), sort=mkSortKey(t);
    controls=mk3Controls(t);
  }
  var body= tab==='follow'?tfSS3FollowTab(): tab==='mine'?tfSS3MineTab(): '<div id="ss3-grid">'+tfSS3GridHtml()+'</div>';
  gContent('<div class="tf-page tfbk ss3 mk">'
    +mkHero()
    +tabs+controls+body
    +'</div>');
  tfBkDropInit();
  var sc=$('g-scroll'); if(sc) sc.scrollTop=0;
}

function tfSS3Apply(){ var g=$('ss3-grid'); if(g) g.innerHTML=tfSS3GridHtml(); }
function tfSS3SortPick(v){
  var t=tfSSState();
