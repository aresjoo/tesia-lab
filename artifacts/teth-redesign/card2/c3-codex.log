#g-root .mk3-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
@media (max-width:1100px){#g-root .mk3-grid{gap:14px}}
@media (max-width:640px){#g-root .mk3-grid{grid-template-columns:minmax(0,1fr)}}
#g-root .mk3{gap:0;padding:18px 18px 16px;border-radius:14px;border-color:rgba(255,255,255,.10);background:#131517}
.mk3-head{display:flex;align-items:center;gap:10px;min-height:28px}
.mk3-g{flex:none;display:block;border-radius:7px}
.mk3-ga{border-radius:50%;filter:grayscale(1) contrast(1.05);background:#1d2024}
.mk3-head h3{margin:0;min-width:0;font-size:18px;font-weight:700;line-height:1.3;letter-spacing:-.01em}
#g-root .mk3 .mk3-t{display:block;font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;color:#f2f3f5}
.mk3-how{display:flex;align-items:baseline;gap:8px;margin:12px 0 0;font-size:13.5px;line-height:1.4;color:var(--gt3);min-width:0}
.mk3-how b{flex:none;font-weight:600;color:#e9ebee}
.mk3-how span{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#g-root .mk3 .mk3-one{margin:6px 0 0;font-size:14px;line-height:1.5;min-height:42px;color:#cfd2d6}
.mk3-now{display:flex;align-items:baseline;gap:8px;margin:12px 0 0;padding:9px 0 0;border-top:1px solid rgba(255,255,255,.08);font-size:12.5px;line-height:1.4;min-width:0}
.mk3-now small{flex:none;font-size:12px;color:var(--gt3)}
.mk3-now span{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#e3e3e3}
.mk3-perf{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:12px 0 0}
#g-root .mk3 .mk3-ret small{margin:0 0 2px;font-size:12px;color:var(--gt3)}
#g-root .mk3 .mk3-ret b{font-size:16px;font-weight:700;line-height:1.2;color:#e9ebee}
#g-root .mk3 .mk3-ret b.mk-up{color:#58b892}
#g-root .mk3 .mk3-ret b.mk-dn{color:#d97a72}
.mk3 .mk-spark{width:72px;height:26px;flex:none;opacity:.85}
.mk3 .mk-spark path[fill^="url"]{display:none}
#g-root .mk3 .mk3-stats{margin:16px 0 0;padding:12px 0 0;border-top:1px solid rgba(255,255,255,.08);display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
#g-root .mk3 .mk3-stats small{display:block;font-size:12px;color:var(--gt3);margin:0 0 2px}
#g-root .mk3 .mk3-stats b{font-size:14px;font-weight:600;color:#e3e3e3}
.mk3-foot{display:flex;align-items:center;gap:8px;margin:14px 0 0}
.mk3-b{height:36px;width:80px;padding:0;border-radius:9px;border:1px solid rgba(255,255,255,.22);background:transparent;color:#e9ebee;font:inherit;font-size:13.5px;font-weight:600;cursor:pointer;white-space:nowrap}
.mk3-b.fill{background:#e9ebee;border-color:#e9ebee;color:#111315}
.mk3-b:hover{border-color:rgba(255,255,255,.5)}
.mk3-b:focus-visible{outline:2px solid #fff;outline-offset:2px}
.mk3-foot .mk3-x{margin-left:auto;font-size:12px;color:var(--gt3);gap:5px}
.mk3-bar{display:block}
.mk3-kindrow{display:flex;align-items:center;gap:18px;margin:0 0 14px;flex-wrap:wrap}
.mk3-seg{display:inline-flex;gap:0;border:1px solid rgba(255,255,255,.14);border-radius:12px;padding:3px;background:#131517;max-width:100%;overflow-x:auto}
.mk3-seg button{height:38px;padding:0 16px;border:0;border-radius:9px;background:none;color:var(--gt2);font:inherit;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:7px}
.mk3-seg button i{font-style:normal;font-size:12px;font-weight:500;color:var(--gt3)}
.mk3-seg button[aria-pressed="true"]{background:#e9ebee;color:#111315}
.mk3-seg button[aria-pressed="true"] i{color:#4b5057}
.mk3-kindhelp{margin:0;flex:1;min-width:260px;font-size:13.5px;line-height:1.5;color:var(--gt2)}
.mk3-flt{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.mk3-flt .mk-chips{margin-right:auto}
.mk3-dh{display:block}
.mk3-dh-top{display:flex;align-items:center;gap:14px}
.mk3-dh-t{min-width:0;flex:1}
.mk3-dh-t h2{margin:0;font-size:26px;font-weight:700;line-height:1.25;letter-spacing:-.02em;color:#f2f3f5}
.mk3-dh-t p{margin:4px 0 0;display:flex;gap:8px;font-size:13.5px;color:var(--gt3)}
.mk3-dh-t p b{color:#e9ebee;font-weight:600}
.mk3-dh-one{margin:14px 0 0;font-size:16px;line-height:1.55;color:#d7dadd;max-width:720px}
.mk3-dh-acts{margin-top:18px;align-items:center}
.mk3-dh-acts .mk-pri{flex:none;min-width:180px}
.mk3-dh-meta{display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--gt3);margin-right:auto}
.mk3-ov{display:block}
.mk3-two{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:14px}
.mk3-nowh{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.mk3-nowp{border-color:rgba(255,255,255,.22)}
.mk3-gauge{position:relative;display:block;height:2px;margin:12px 0 6px;background:rgba(255,255,255,.16);border-radius:2px;max-width:280px}
.mk3-gauge u{position:absolute;top:-6px;width:1.5px;height:14px;background:#e9ebee;text-decoration:none}
.mk3-gauge i{position:absolute;top:-4px;width:10px;height:10px;margin-left:-5px;border-radius:50%;background:#131517;border:2px solid #e9ebee}
.mk3-gauge-t{display:block;font-size:12.5px;color:var(--gt3)}
.mk3-since{margin:14px 0 0;font-size:12.5px;color:var(--gt3)}
.mk3-panel{border:1px solid rgba(255,255,255,.10);border-radius:14px;background:#131517;padding:20px 22px;min-width:0}
.mk3-panel h3,.mk3-sec h3{margin:0 0 12px;font-size:15px;font-weight:700;color:#f2f3f5}
.mk3-kv{display:grid;grid-template-columns:108px minmax(0,1fr);gap:12px;padding:9px 0;border-top:1px solid rgba(255,255,255,.07);font-size:14px;line-height:1.55}
.mk3-kv:first-of-type{border-top:0}
.mk3-kv small{font-size:13px;color:var(--gt3)}
.mk3-kv span{color:#e3e3e3;min-width:0}
.mk3-kv i{font-style:normal;color:var(--gt2)}
.mk3-kv i.mk-up{color:#58b892}.mk3-kv i.mk-dn{color:#d97a72}
.mk3-state{margin:0 0 6px;font-size:20px;font-weight:700;line-height:1.35;color:#f2f3f5}
.mk3-asof{font-size:12px;color:var(--gt3)}
.mk3-steps{list-style:none;margin:4px 0 6px;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.mk3-steps li{border:1px solid rgba(255,255,255,.10);border-radius:10px;padding:10px 12px;min-width:0;opacity:.55}
.mk3-steps li.on{opacity:1;border-color:rgba(255,255,255,.55)}
.mk3-steps li.done{opacity:.85}
.mk3-steps small{display:block;font-size:11.5px;color:var(--gt3)}
.mk3-steps b{display:block;font-size:13.5px;margin:2px 0 3px;color:#f2f3f5}
.mk3-steps span{display:block;font-size:12.5px;color:var(--gt2);min-height:18px}
.mk3-sec{margin:34px 0 0}
.mk3-sec-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.mk3-evs{list-style:none;margin:0;padding:0;border-top:1px solid rgba(255,255,255,.08)}
.mk3-ev{display:grid;grid-template-columns:92px minmax(0,1fr);gap:16px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.08)}
.mk3-ev-d{font-size:13px;color:var(--gt3);line-height:1.5}
.mk3-ev-d small{display:block;font-size:11.5px}
.mk3-ev-b b{display:block;font-size:15px;font-weight:600;line-height:1.45;color:#f2f3f5}
.mk3-ev-b b i{font-style:normal;font-size:11.5px;font-weight:600;color:#111315;background:#c9cdd2;border-radius:4px;padding:1px 6px;margin-right:8px;vertical-align:1px}
.mk3-ev-b span{display:block;margin:3px 0 0;font-size:13.5px;line-height:1.5;color:var(--gt2)}
.mk3-ev-b em{display:block;margin:3px 0 0;font-style:normal;font-size:13px;color:var(--gt3);font-variant-numeric:tabular-nums}
.mk3-ev.first .mk3-ev-b b{font-size:17px}
.mk3-how4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.mk3-how4>div{border-top:1px solid rgba(255,255,255,.16);padding:12px 0 0}
.mk3-how4 small{font-size:13px;color:var(--gt3)}
.mk3-how4 p{margin:6px 0 0;font-size:14px;line-height:1.55;color:#e3e3e3}
.mk3-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 18px;padding:14px 0;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}
.mk3-kpis small{display:block;font-size:12.5px;color:var(--gt3);margin:0 0 3px}
.mk3-kpis b{font-size:18px;font-weight:700;color:#e9ebee}
.mk3-kpis b.mk-up{color:#58b892}.mk3-kpis b.mk-dn{color:#d97a72}
  .mk3-two{grid-template-columns:minmax(0,1fr)}
  .mk3-how4{grid-template-columns:repeat(2,minmax(0,1fr))}
  .mk3-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
  .mk3-ev{grid-template-columns:70px minmax(0,1fr);gap:10px}
  .mk3-dh-t h2{font-size:22px}
  .mk3-kv{grid-template-columns:92px minmax(0,1fr)}
  .mk3-steps{grid-template-columns:minmax(0,1fr)}
  .mk3-dh-acts{flex-wrap:wrap}
  .mk3-dh-acts .mk-pri{flex:0 0 120px;min-width:0;height:44px;padding:0}
  .mk3-dh-meta{order:3;flex:0 0 100%;margin:4px 0 0}
  #g-root .mk3 .mk3-one{min-height:0}
  .mk3-b{height:44px}
