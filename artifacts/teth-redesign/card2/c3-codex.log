30:/* 캐시 키: 전략 ID, 행동 값 전체, 쓰는 자산의 가격 설정, 마지막 봉, 비용 */
31:function mkSig(s){ if(!s.cfg) return tfSS3Rid(s)+'|'+(s.p?JSON.stringify(s.p):'')+'|'+((s.r&&s.r.eq||[]).length); var c=s.cfg, ks=c.asset?[c.asset]:MK_UNI[c.uni].list; return c.id+'|'+JSON.stringify(c)+'|'+ks.map(function(k){ return (MK_PX_CFG[k]||[]).join('/'); }).join(',')+'|'+PRICE0.length+'|'+MK_FEE+'|'+MK_DATA_V; }
32:/* 카탈로그나 가격 설정이 바뀌면 시드, 목록, 기간 계산을 함께 버린다 */
33:var MK_CATSIG=null;
34:function mkCatSig(){ return JSON.stringify(MK_CAT)+JSON.stringify(MK_PX_CFG)+MK_DATA_V+MK_FEE+'|'+PRICE0.length+'|'+MK_ASOF.join('-'); }
35:function tfRankSeeds(){
36:  var sig=mkCatSig(); if(TF_SEEDS&&MK_CATSIG===sig) return TF_SEEDS;
37:  MK_CATSIG=sig; TF_SS_CACHE=null; MK_PDC={};
38:  TF_SEEDS=MK_CAT.map(function(c,k){
39:    var r=mkRunCfg(c);
40:    return {id:c.id,ord:k+1,kind:c.kind,mkt:c.mkt,nick:c.name,name:c.name,one:c.one,asset:c.kind==='rule'?c.asset:MK_UNI[c.uni].label,uni:c.uni||null,cfg:c,ex:c.ex,p:null,fw:c.fw,by:c.by||'',score:tfScore(r),ret:r.ret,mdd:r.mdd,n:r.n,r:r};
41:  });
42:  mkMigrate();
43:  return TF_SEEDS;
44:}
45:/* 저장된 즐겨찾기와 따라가기의 이름을 현재 이름으로 맞춘다(별칭으로 찾을 수 있는 것만). 돈과 기록은 건드리지 않는다 */
46:function mkMigrate(){
47:  try{ var t=tfS(), ch=false, canon=function(n){ var id=MK_ALIAS[n]||n; for(var i=0;i<MK_CAT.length;i++) if(MK_CAT[i].id===id) return MK_CAT[i].name; return n; };
48:    if(t.watch){ var w=[]; t.watch.forEach(function(n){ var c=canon(n); if(c!==n) ch=true; if(w.indexOf(c)<0) w.push(c); else ch=true; }); t.watch=w; }
49:    if(t.cp&&t.cp.copies) t.cp.copies.forEach(function(c){ var n=canon(c.nick); if(n!==c.nick){ c.nick0=c.nick; c.nick=n; ch=true; }
50:      /* 데이터 세대가 바뀌면 저장된 봉 번호를 같은 날짜의 새 봉 번호로 옮긴다 */
51:      var g=c.gen, now={asof:MK_ASOF.slice(),len:PRICE0.length};
52:      if(!g){ g=c.gen={asof:MK_GEN0.asof.slice(),len:MK_GEN0.len}; ch=true; }
53:      if(g.len!==now.len||g.asof.join('-')!==now.asof.join('-')){ var d0=new Date(g.asof[0],g.asof[1]-1,g.asof[2]), d1=new Date(now.asof[0],now.asof[1]-1,now.asof[2]), sh=(now.len-g.len)-Math.round((d1-d0)/86400000); ['simStartI','flatI'].forEach(function(k){ if(c[k]!=null) c[k]=Math.max(0,Math.min(now.len-1,c[k]+sh)); }); c.gen=now; ch=true; } });
54:    if(ch) tfSave(); }catch(e){}
55:}
56:function tfSSRows(){
57:  tfRankSeeds();
58:  if(!TF_SS_CACHE) TF_SS_CACHE=tfRankSeeds().map(function(s){ var o={}; for(var k in s) o[k]=s[k]; return o; });
59:  var t=tfSSState(), rows=TF_SS_CACHE.slice();
60:  if(t.shared&&t.sharedSnap){
61:    var sn=t.sharedSnap;
62:    rows.push({nick:(S.user&&S.user.name)||'나',title:sn.name,desc:sn.desc,asset:sn.asset,kind:'rule',mkt:'crypto',p:sn.p,fw:t.followers||0,score:sn.score,me:true,
63:      r:sn.p?runBacktest(sn.p):{ret:sn.ret,mdd:sn.mdd,n:sn.n,winRate:sn.winRate||0,eq:null,trades:[],byYear:{},pf:0,avgHold:0,lossCount:0}});
64:  }
65:  return rows;
66:}
67:/* 조회: 전략 ID, 현재 이름, 옛 이름(별칭) 모두 같은 전략을 돌려준다 */
68:function tfSSFind(nick){
69:  var rows=tfSSRows();
70:  if(nick==='me'){
71:    for(var k=0;k<rows.length;k++) if(rows[k].me) return rows[k];
72:    var t0=tfS(), sn0=t0.sharedSnap;
73:    if(sn0) return {nick:(S.user&&S.user.name)||'나',title:sn0.name,desc:sn0.desc,asset:sn0.asset,kind:'rule',p:sn0.p,fw:t0.followers||0,score:sn0.score,me:true,
74:      r:sn0.p?runBacktest(sn0.p):{ret:sn0.ret,mdd:sn0.mdd,n:sn0.n,winRate:sn0.winRate||0,eq:null,trades:[],byYear:{},pf:0,avgHold:0,lossCount:0}};
75:    return null;
76:  }
77:  var id=MK_ALIAS[nick]||null;
78:  for(var i=0;i<rows.length;i++) if(!rows[i].me&&(rows[i].id===nick||rows[i].nick===nick||(id&&rows[i].id===id))) return rows[i];
79:  return null;
80:}
81:var MK_PDC={};
82:function tfSS3PdCalc(s,pd){
83:  if(pd==='all'||(!s.p&&!s.cfg)) return s.r;
84:  var days=pd==='1y'?365:730, end=PRICE0.length-1, key=mkSig(s)+'|'+pd;
85:  if(!MK_PDC[key]) MK_PDC[key]=s.cfg?mkRunCfg(s.cfg,Math.max(s.cfg.startI||61,end-days)):runBacktest({sl:s.p.sl,tp:s.p.tp,rsiTh:s.p.rsiTh,trendFilter:s.p.trendFilter,startI:Math.max(61,s.p.startI||61,s.p.endI-days),endI:s.p.endI,px:s.p.px,fill:s.p.fill});
86:  return MK_PDC[key];
87:}
88:/* 30일 수익률: 매번 결과에서 바로 계산한다(값이 바뀌면 곧바로 반영) */
89:function mk30(s){
90:  var r=s.r||tfSS3PdCalc(s,'all'), e=r.eq||[], d=(e.length&&e[e.length-1].i-e[0].i===e.length-1?e:mkDaily(e,PRICE0.length-1)).slice(-31), b0=d.length?d[0].v:1;
91:  d=d.map(function(x){ return {i:x.i,v:x.v/b0}; });
92:  return {ret:d.length>1?(d[d.length-1].v-1)*100:0,eq:d};
