63:          for(var sq=0;sq<rk;sq++){ var sr=S.rows[sq]; skip.push({k:sr.k,why:L.pos.some(function(p){ return p.k===sr.k; })?'held':!sr.above?'below':'weak'}); }
64:          var p2=L.buy(r2.k,r2.px,w*total,i,{w:w}); if(!p2) break;
