  tfTrack('cp_close',{id:cid,net:d.net});
  if(silent) return;
  toast('따라가기를 중단했어요'+(c2.stopMode&&c2.stopMode!=='now'?' ('+MK_STOP_L[c2.stopMode]+')':'')+'. '+cpUsd(back,0)+'가 예산으로 돌아왔어요');
  tfShareHub('follow');
}

