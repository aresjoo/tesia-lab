152:  var X=function(j){ return 1+j/(n-1)*(W-2); }, Y=function(v){ return pad+(1-(v-min)/(max-min))*(H-pad*2); };
153:  var P=eq.map(function(e,j){ return [X(j),Y(e.v)]; });
154:  /* 꺾이는 곳만 살짝 둥글게(반지름 2.5). 평평한 구간은 평평하게 남는다 */
155:  var d='M'+P[0][0].toFixed(1)+' '+P[0][1].toFixed(1), R=2.5;
