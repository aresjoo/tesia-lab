118:// Motion recording: screencast frames with timestamps while fn() runs.
119:export async function record(c, dir, name, fn, extraMs = 900) {
120:  fs.mkdirSync(dir, { recursive: true });
121:  const frames = [];
122:  c.on('Page.screencastFrame', async p => {
123:    frames.push({ ts: p.metadata.timestamp, data: p.data });
124:    try { await c.send('Page.screencastFrameAck', { sessionId: p.sessionId }); } catch {}
125:  });
126:  await c.send('Page.startScreencast', { format: 'png', everyNthFrame: 1 });
127:  await fn();
128:  await sleep(extraMs);
129:  await c.send('Page.stopScreencast');
130:  c.off('Page.screencastFrame');
131:  const meta = [];
132:  frames.forEach((f, i) => {
133:    const fp = `${dir}/${name}-f${String(i).padStart(3, '0')}.png`;
134:    fs.writeFileSync(fp, Buffer.from(f.data, 'base64'));
135:    meta.push({ frame: i, ts: f.ts, file: fp.split('/').pop() });
136:  });
137:  fs.writeFileSync(`${dir}/${name}-timeline.json`, JSON.stringify(meta, null, 2));
138:  return meta.length;
139:}
