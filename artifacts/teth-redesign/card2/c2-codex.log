81:export async function shot(c, path, { full = true, clip = null } = {}) {
82:  const params = { format: 'png' };
83:  if (clip) params.clip = { x: Math.max(0, clip.x), y: Math.max(0, clip.y), width: Math.max(1, clip.width), height: Math.max(1, clip.height), scale: 1 };
84:  else if (full) params.captureBeyondViewport = true;
85:  const { data } = await c.send('Page.captureScreenshot', params, 90000);
86:  fs.writeFileSync(path, Buffer.from(data, 'base64'));
87:  return path;
88:}
