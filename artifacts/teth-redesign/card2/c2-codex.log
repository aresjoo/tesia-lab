97:export async function move(c, x, y) { await c.send('Input.dispatchMouseEvent', { type: 'mouseMoved', x, y }); }
98:export async function click(c, x, y) {
99:  await move(c, x, y);
100:  await c.send('Input.dispatchMouseEvent', { type: 'mousePressed', x, y, button: 'left', clickCount: 1 });
101:  await c.send('Input.dispatchMouseEvent', { type: 'mouseReleased', x, y, button: 'left', clickCount: 1 });
102:}
103:export async function clickSel(c, selector) {
104:  const box = await evala(c, `(()=>{const els=[...document.querySelectorAll(${JSON.stringify(selector)})];for(const e of els){const b=e.getBoundingClientRect();if(b.width>2&&b.height>2)return {x:b.x+b.width/2,y:b.y+b.height/2};}return null;})()`);
105:  if (!box) throw new Error('clickSel: not found ' + selector);
106:  await click(c, box.x, box.y);
107:  return box;
108:}
