110:const VK = { Escape: 27, Enter: 13, Tab: 9, Space: 32, ArrowDown: 40, ArrowUp: 38, ArrowLeft: 37, ArrowRight: 39 };
111:export async function key(c, name, modifiers = 0) {
112:  const code = VK[name]; const text = name === 'Enter' ? '\r' : name === 'Space' ? ' ' : '';
113:  await c.send('Input.dispatchKeyEvent', { type: 'rawKeyDown', windowsVirtualKeyCode: code, key: name, modifiers });
114:  if (text) await c.send('Input.dispatchKeyEvent', { type: 'char', text });
115:  await c.send('Input.dispatchKeyEvent', { type: 'keyUp', windowsVirtualKeyCode: code, key: name, modifiers });
116:}
