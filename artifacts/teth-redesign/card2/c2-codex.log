40:export async function newPage(port = 9333) {
41:  const t = await fetch(`http://127.0.0.1:${port}/json/new?about:blank`, { method: 'PUT' }).then(r => r.json());
42:  const c = await CDP.connect(t.webSocketDebuggerUrl);
43:  c.targetId = t.id;
44:  await c.send('Page.enable');
45:  await c.send('Runtime.enable');
46:  await c.send('Network.enable');
47:  // Plain (non-headless) UA so the reference serves its normal experience
48:  const ver = await fetch(`http://127.0.0.1:${port}/json/version`).then(r => r.json());
49:  const ua = ver['User-Agent'].replace('HeadlessChrome', 'Chrome');
50:  await c.send('Network.setUserAgentOverride', { userAgent: ua, acceptLanguage: 'en-US,en' });
51:  return c;
52:}
