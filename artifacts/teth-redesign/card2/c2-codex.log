58:export async function evala(c, expr) {
59:  const r = await c.send('Runtime.evaluate', { expression: expr, returnByValue: true, awaitPromise: true });
60:  if (r.exceptionDetails) throw new Error('evala: ' + JSON.stringify(r.exceptionDetails).slice(0, 600));
61:  return r.result.value;
62:}
