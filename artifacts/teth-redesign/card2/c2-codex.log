7:export class CDP {
8:  constructor(ws) {
9:    this.ws = ws; this.id = 0; this.pend = new Map(); this.listeners = new Map();
10:    ws.addEventListener('message', ev => {
11:      const m = JSON.parse(ev.data);
12:      if (m.id && this.pend.has(m.id)) {
13:        const { res, rej } = this.pend.get(m.id); this.pend.delete(m.id);
14:        m.error ? rej(new Error(m.error.message)) : res(m.result);
15:      } else if (m.method) {
16:        const l = this.listeners.get(m.method); if (l) l.forEach(f => f(m.params));
17:      }
18:    });
19:  }
20:  static async connect(wsUrl) {
21:    const ws = new WebSocket(wsUrl);
22:    await new Promise((res, rej) => { ws.addEventListener('open', res); ws.addEventListener('error', e => rej(new Error('ws error'))); });
23:    return new CDP(ws);
24:  }
25:  send(method, params = {}, timeoutMs = 25000) {
26:    const id = ++this.id;
27:    this.ws.send(JSON.stringify({ id, method, params }));
28:    return new Promise((res, rej) => {
29:      const t = setTimeout(() => { if (this.pend.has(id)) { this.pend.delete(id); rej(new Error('CDP timeout: ' + method)); } }, timeoutMs);
30:      this.pend.set(id, { res: v => { clearTimeout(t); res(v); }, rej: e => { clearTimeout(t); rej(e); } });
31:    });
32:  }
33:  on(method, fn) {
34:    if (!this.listeners.has(method)) this.listeners.set(method, []);
35:    this.listeners.get(method).push(fn);
36:  }
37:  off(method) { this.listeners.delete(method); }
38:}
