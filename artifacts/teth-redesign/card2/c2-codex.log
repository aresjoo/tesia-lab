64:export async function goto(c, url, settleMs = 1500, timeoutMs = 30000) {
65:  await c.send('Page.navigate', { url });
66:  const t0 = Date.now();
67:  while (Date.now() - t0 < timeoutMs) {
68:    try { if (await evala(c, 'document.readyState') === 'complete') break; } catch {}
69:    await sleep(300);
70:  }
71:  await sleep(settleMs);
72:}
