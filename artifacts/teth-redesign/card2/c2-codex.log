74:export async function viewport(c, w, h, { dsf = 1, mobile = false, dark = true } = {}) {
75:  await c.send('Emulation.setDeviceMetricsOverride', { width: w, height: h, deviceScaleFactor: dsf, mobile, screenWidth: w, screenHeight: h });
76:  await c.send('Emulation.setEmulatedMedia', { features: [{ name: 'prefers-color-scheme', value: dark ? 'dark' : 'light' }] });
77:  if (mobile) await c.send('Emulation.setTouchEmulationEnabled', { enabled: true, maxTouchPoints: 5 });
78:  else await c.send('Emulation.setTouchEmulationEnabled', { enabled: false });
79:}
