90:// Element screenshot by selector (first visible match)
91:export async function shotEl(c, path, selector, pad = 0) {
92:  const box = await evala(c, `(()=>{const els=[...document.querySelectorAll(${JSON.stringify(selector)})];for(const e of els){const b=e.getBoundingClientRect();if(b.width>2&&b.height>2)return {x:b.x+scrollX,y:b.y+scrollY,width:b.width,height:b.height};}return null;})()`);
93:  if (!box) return null;
94:  return shot(c, path, { clip: { x: box.x - pad, y: box.y - pad, width: box.width + pad * 2, height: box.height + pad * 2 } });
95:}
