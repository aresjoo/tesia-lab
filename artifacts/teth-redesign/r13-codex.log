{"ok":true,"value":"/* ── 카피 상태 (3단계): t.cp — 저장은 원시값, 표시는 파생 ── */\r\nfunction cpState(){\r\n  var t=tfS();\r\n  if(!t.cp) t.cp={v:1,spot:1000,copies:[]}; /* 데모 스팟 잔고 1000 USDT 시드 */\r\n  if(!Array.isArray(t.cp.copies)) t.cp.copies=[];\r\n  if(t.cp.spot==null) t.cp.spot=1000;\r\n  return t.cp;\r\n}\r\nfunction cpFind(id){ return cpState().copies.find(function(x){ return x.id===id; })||null; }\r\n/* 파생 계산 단일 함수 — 서머리/카드/상세가 전부 이걸 쓴다 (수치 불일치 구조적 차단).\r\n   데모: 카피 시작을 시뮬레이션 30봉 전으로 간주 (실서버: 실시간 체결 스트림) */\r\nfunction cpCalc(c2){\r\n  var s2=tfSSFind(c2.nick), m=s2?cpMeta(c2.nick):null;\r\n  var inv=c2.ledger.reduce(function(a,e){ return a+(e.type==='add'?e.amt:-e.amt); },0);\r\n  if(!s2||!s2.r.eq||s2.r.eq.length<32) return {inv:inv,pnlPct:0,total:0,realized:0,unreal:0,share:0,net:0,est:inv,avail:inv,posOpen:false,missing:!s2};\r\n  var eq=s2.r.eq;\r\n  var startI=c2.simStartI!=null?c2.simStartI:eq[eq.length-31].i;\r\n  var e0=null,e1=eq[eq.length-1];\r\n  for(var k=0;k<eq.length;k++){ if(eq[k].i>=startI){ e0=eq[k]; break; } }\r\n  if(!e0) e0=eq[0];\r\n  if(c2.flatI!=null){ /* 수동 정리: 손익 구간을 정리 시점에서 고정 (성역 — 이후 트레이더 손익은 미반영, 다음 진입 대기) */\r\n    for(var k2=eq.length-1;k2>=0;k2--){ if(eq[k2].i<=c2.flatI){ e1=eq[k2]; break; } }\r\n  }\r\n  var pnlPct=e1.v/e0.v-1;\r\n  var total=c2.amount*pnlPct; /* 증액분은 다음 진입부터 반영 — 데모 단순화: 초기 금액 기준 */\r\n  var closed=(s2.r.trades||[]).filter(function(x){ var e=(x.exit!=null?x.exit:x.entry); return e>=startI&&(c2.flatI==null||e<=c2.flatI); });\r\n  /* 실현손익 = 마지막 청산 시점의 곡선값 기준 — 총손익과 같은 척도라 산식 차이가 가상 포지션을\r\n     만들지 않는다. 미실현 = 마지막 청산 이후 구간의 변화만 (codex P1-5 근본 수정) */\r\n  var lastX=-1; closed.forEach(function(x){ var e=(x.exit!=null?x.exit:x.entry); if(e>lastX) lastX=e; });\r\n  var eLast=e0;\r\n  if(lastX>=0){ for(var k3=eq.length-1;k3>=0;k3--){ if(eq[k3].i<=lastX){ eLast=eq[k3]; break; } } }\r\n  var realized=lastX>=0?c2.amount*(eLast.v/e0.v-1):0;\r\n  var unreal=total-realized;\r\n  if(c2.flatI!=null){ realized=total; unreal=0; } /* 수동 정리: 미실현을 실현으로 확정 */\r\n  var share=Math.max(0,realized)*(m?m.share:0.1);\r\n  var net=total-share;\r\n  var posOpen=Math.abs(unreal)>c2.amount*0.002;\r\n  var est=inv+net;\r\n  var avail=Math.max(0,est-(posOpen?c2.amount*0.4:0));\r\n  return {inv:inv,pnlPct:pnlPct,total:total,realized:realized,unreal:unreal,share:share,net:net,est:est,avail:avail,posOpen:posOpen,closedN:closed.length};\r\n}\r\n/* ── Adjust balance 모달 — 따라가기 탭과 카피 상세가 공유 (핵심 원칙 4: 손실 중 입금 보호) ── */\r\nvar TF_CPA={dir:'add'};\r\nfunction cpAdjDlg(cid){\r\n  var c2=cpFind(cid); if(!c2||c2.status!=='active'){ toast('진행 중인 따라가기가 아니에요'); return; }\r\n  TF_CPA={dir:'add'};\r\n  cpAdjRender(cid);\r\n}\r\nfunction cpAdjRender(cid){\r\n  var c2=cpFind(cid); if(!c2) return;\r\n  var cp=cpState(), d=cpCalc(c2), dir=TF_CPA.dir, cfg=cpCfg();\r\n  var pnlP=d.pnlPct*100, up=pnlP>=0;\r\n  tfSS3Dlg('예산 조정, '+c2.nick,\r\n    '<div class=\"cpa-pnl\">이 따라가기의 현재 수익률 <b class=\"num '+(up?'u':'d')+'\">'+(up?'+':'')+pnlP.toFixed(1)+'%</b>'\r\n    +(!up&&pnlP<=(cfg.LOSS_GUARD||-0.2)*100?'<br><span style=\"color:#e8d49a\">손실 구간에서 추가 입금은 평균 단가를 낮추지만 위험도 같이 커져요.</span>':'')+'</div>'\r\n    +'<div class=\"cpa-tgl\"><button type=\"button\" class=\"'+(dir==='add'?'on':'')+'\" onclick=\"TF_CPA.dir=\\'add\\';cpAdjRender(\\''+cid+'\\')\">예산 추가</button>'\r\n    +'<button type=\"button\" class=\"'+(dir==='out'?'on':'')+'\" onclick=\"TF_CPA.dir=\\'out\\';cpAdjRender(\\''+cid+'\\')\">회수</button></div>'\r\n    +'<div class=\"cps-fld\" style=\"margin-bottom:6px\"><div class=\"cps-in\"><input id=\"cpa-amt\" type=\"number\" inputmode=\"decimal\" placeholder=\"금액\" oninput=\"cpAdjSync(\\''+cid+'\\')\"><span class=\"un\">USDT</span>'\r\n    +'<button type=\"button\" class=\"mx\" onclick=\"$(\\'cpa-amt\\').value='+(dir==='add'?cp.spot:Math.floor(d.avail*100)/100)+';cpAdjSync(\\''+cid+'\\')\">최대</button></div>'\r\n    +'<div class=\"cps-bal\">'+(dir==='add'?'추가 가능 <b class=\"num\">'+cpUsd(cp.spot,2)+'</b>':'회수 가능 <b class=\"num\">'+cpUsd(d.avail,2)+'</b>')+'</div>'\r\n    +'<div class=\"cps-err\" id=\"cpa-err\" style=\"display:block;color:#ee9a91\"></div></div>'\r\n    +'<div class=\"cpa-note\">'+(dir==='add'?'추가한 금액은 다음 진입부터 반영돼요.':'포지션에 잡혀 있는 금액은 회수할 수 없어요.')+'</div>'\r\n    +'<div class=\"acts3\" style=\"margin-top:16px\"><button type=\"button\" class=\"obtn\" onclick=\"tfSS3DlgClose()\">취소</button>'\r\n    +'<button type=\"button\" class=\"wbtn\" id=\"cpa-go\" disabled onclick=\"cpAdjGo(\\''+cid+'\\')\">확인</button></div>');\r\n}\r\nfunction cpAdjSync(cid){\r\n  var c2=cpFind(cid); if(!c2) return false;\r\n  var cp=cpState(), d=cpCalc(c2), el=$('cpa-amt'), go=$('cpa-go'), err=$('cpa-err');\r\n  var v=parseFloat(el&&el.value), dir=TF_CPA.dir, msg='';\r\n  if(el&&el.value!==''){\r\n    if(!isFinite(v)||v<=0) msg='0보다 큰 금액을 입력해주세요';\r\n    else if(dir==='add'&&v>cp.spot) msg='사용 가능 금액보다 커요';\r\n    else if(dir==='out'&&v>d.avail+1e-9) msg='회수 가능 금액을 넘었어요';\r\n  }\r\n  if(err) err.textContent=msg;\r\n  var ok=el&&el.value!==''&&isFinite(v)&&v>0&&!msg;\r\n  if(go) go.disabled=!ok;\r\n  return ok;\r\n}\r\nfunction cpAdjGo(cid){\r\n  if(!cpAdjSync(cid)) return;\r\n  var c2=cpFind(cid), cp=cpState(), d=cpCalc(c2), cfg=cpCfg();\r\n  var v=parseFloat($('cpa-amt').value), dir=TF_CPA.dir;\r\n  /* 보호 장치: 손실 -20% 이하에서 추가 입금은 확인 1단계 추가 (핵심 원칙 4) */\r\n  if(dir==='add'&&d.pnlPct<=(cfg.LOSS_GUARD||-0.2)&&!TF_CPA.confirmed){\r\n    TF_CPA.confirmed=false;\r\n    tfSS3Dlg('잠깐, 손실 구간이에요',\r\n      '<div class=\"ntc\">이 따라가기는 지금 <b style=\"color:#ee766a\">'+(d.pnlPct*100).toFixed(1)+'%</b> 손실 중이에요.<br>'\r\n      +'손실 후 반복 입금은 수익률을 실제보다 부풀려 보이게 하고, 같은 전략에 위험만 키울 수 있어요.<br>그래도 추가할까요?</div>'\r\n      +'<div class=\"acts3\" style=\"margin-top:16px\"><button type=\"button\" class=\"obtn\" onclick=\"TF_CPA.confirmed=false;cpAdjRender(\\''+cid+'\\')\">다시 생각할게요</button>'\r\n      +'<button type=\"button\" class=\"wbtn\" onclick=\"TF_CPA.confirmed=true;cpAdjCommit(\\''+cid+'\\','+v+',\\'add\\')\">'+cpUsd(v,0)+' 추가할게요</button></div>');\r\n    return;\r\n  }\r\n  cpAdjCommit(cid,v,dir);\r\n}\r\nfunction cpAdjCommit(cid,v,dir){\r\n  var c2=cpFind(cid), cp=cpState(); if(!c2) return;\r\n  if(dir==='add'){ if(v>cp.spot){ toast('사용 가능 금액이 부족해요'); return; } cp.spot-=v; }\r\n  else { cp.spot+=v; }\r\n  c2.ledger.push({at:Date.now(),type:dir,amt:v}); /* append-only */\r\n  TF_CPA.confirmed=false;\r\n  tfSaveNow(); tfSS3DlgClose();\r\n  tfTrack('cp_adjust',{id:cid,dir:dir,amt:v});\r\n  toast(dir==='add'?cpUsd(v,0)+'를 예산에 추가했어요':cpUsd(v,0)+'를 회수했어요');\r\n  if(G.mode==='tfss3') tfShareHub('follow');\r\n  else if(G.mode==='tfcpx') cpDetailView(cid,'bal'); /* 상세에서 조정하면 자금 이동 탭으로 (cp 5단계) */\r\n}\r\n/* 카피 종료 — 정산: 분배 차감 후 회수, 원장 close 엔트리 (강제 청산 아님: 수동 결정) */\r\nfunction cpCloseDlg(cid){ mkStopDlg(cid); } /* S7: 중단 3택 (지금 정리 / 원본 청산 대기 / 직접 관리) */\r\nfunction cpClose(cid,silent){\r\n  var c2=cpFind(cid), cp=cpState(); if(!c2||c2.status!=='active') return;\r\n  var d=cpCalc(c2);\r\n  var back=Math.max(0,d.est);\r\n  c2.status='closed'; c2.closedAt=Date.now(); c2.settle={net:d.net,share:d.share,back:back};\r\n  c2.ledger.push({at:Date.now(),type:'out',amt:back}); /* 정산 회수도 원장 */\r\n  cp.spot+=back;\r\n  tfSaveNow(); tfSS3DlgClose();\r\n  tfTrack('cp_close',{id:cid,net:d.net});\r\n  if(silent) return;\r\n  toast('따라가기를 중단했어요'+(c2.stopMode&&c2.stopMode!=='now'?' ('+MK_STOP_L[c2.stopMode]+')':'')+'. '+cpUsd(back,0)+'가 예산으로 돌아왔어요');\r\n  tfShareHub('follow');\r\n}\r\n/* ── Copy details (5단계): 카피별 상세 5탭 — 헤더/탭 전부 cpCalc 단일 소스 ── */\r\nfunction cpDetailGo(cid,tab){\r\n  tfTrack('cp_detail_open',{id:cid,tab:tab||'pos'});\r\n  var r='#/share/c/'+cid+(tab&&tab!=='pos'?'/'+tab:'');\r\n  try{ if(location.hash.indexOf('#/share/c/')===0) history.replaceState(null,'',location.pathname+location.search+r);\r\n       else history.pushState(null,'',location.pathname+location.search+r); }catch(e){}\r\n  cpDetailView(cid,tab||'pos');\r\n}\r\nfunction cpDetailRoute(h){\r\n  var m=h.match(/^#\\/share\\/c\\/([^\\/]+?)(?:\\/(pos|hist|share|bal|tx))?$/);\r\n  if(!m){ TF_ONSHARE=false; tfShareHub('follow'); return; }\r\n  cpDetailView(m[1],m[2]||'pos');\r\n}\r\nfunction cpDetailView(cid,tab){\r\n  var c2=cpFind(cid);\r\n  if(!c2){ toast('따라가기 기록을 찾을 수 없어요'); TF_ONSHARE=false; try{ history.replaceState(null,'',location.pathname+location.search); }catch(e){} tfShareHub('follow'); return; }\r\n  tfSS3DlgClose(true);\r\n  TF_ONSHARE=true; TF_ONSTRAT=false; window.TF_ONNF=false;\r\n  G.cur=null; G.mode='tfcpx'; G.tabs=[]; G.activeTab=null;\r\n  document.body.classList.remove('kb-open'); gComposer(false);\r\n  $('g-aux').style.display='none'; gSideRender(); gTabsRender();\r\n  gChead('따라가기 상세','',null);\r\n  var d=cpCalc(c2), m=cpMeta(c2.nick), ne=tfSSNe(c2.nick), on=c2.status==='active';\r\n  var TABS=[['pos','포지션'],['hist','청산 이력'],['share','수익 분배'],['bal','자금 이동'],['tx','거래 내역']];\r\n  var body= tab==='pos'?cpxPos(c2,d):tab==='hist'?cpxHist(c2,d):tab==='share'?cpxShare(c2,d,m):tab==='bal'?cpxBal(c2,d):cpxTx(c2,d);\r\n  var K=function(lb,v,clr,tip){ return '<div class=\"cpp-kpi\"><small'+(tip?' title=\"'+tip+'\"':'')+'>'+lb+'</small><b class=\"num'+(clr?(v>=0?' u':' d'):'')+'\">'+cpUsd(v)+'</b></div>'; };\r\n  TF_RENDERING=true; document.body.classList.remove('tf-route');\r\n  gContent('<div class=\"tf-page tfbk ss3 cpp cpx\">'\r\n    +'<button type=\"button\" class=\"ss3-back\" onclick=\"TF_ONSHARE=false;try{history.replaceState(null,\\'\\',location.pathname+location.search);}catch(e){}tfShareHub(\\'follow\\')\">← 따라가는 중</button>'\r\n    +'<div class=\"cpp-head\"><div class=\"cpp-ava\" aria-hidden=\"true\">'+gEsc(c2.nick.slice(0,1))+'</div>'\r\n    +'<div class=\"cpp-idm\"><div class=\"cpp-nick\"><button type=\"button\" class=\"nm\" style=\"font-size:19px\" onclick=\"cpProfileGo(\\''+ne+'\\')\">'+gEsc(c2.nick)+'</button></div>'\r\n    +'<div class=\"cpp-meta num\"><span>비율 따라가기</span><span title=\"Profit share ratio\">수익 분배 '+Math.round(m.share*100)+'%</span>'\r\n    +'<span>'+new Date(c2.at).toLocaleString('ko-KR',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'})+' 시작</span>'\r\n    +'<span class=\"'+(on?'':'')+'\">'+(on?(c2.winding?'정리 대기':'따라가는 중'):'중단됨')+'</span></div></div>'\r\n    +'<div class=\"cpp-acts\">'\r\n    +(on&&c2.winding?mkWindActs(cid):on?'<button type=\"button\" class=\"obtn\" onclick=\"cpAdjDlg(\\''+cid+'\\')\">예산 조정</button>'\r\n      +'<button type=\"button\" class=\"obtn\" onclick=\"cpEditSheet(\\''+cid+'\\')\">설정</button>'\r\n      +'<button type=\"button\" class=\"ss3-dbtn\" onclick=\"cpCloseDlg(\\''+cid+'\\')\">중단</button>':'')\r\n    +'</div></div>'\r\n    +(d.missing?'<div class=\"warn3\" style=\"margin:0 0 12px\">이전 목록의 전략이라 지금은 기록을 불러올 수 없어요. 넣은 금액은 그대로 보관돼요.</div>':'')\r\n    +'<div class=\"mk-acct\"><b>내 따라가기 계정</b><span>내 예산 기준 손익이에요. 원본 전략의 검증 수치와는 달라요</span></div>'\r\n    +'<div class=\"cpd-sum num\">'\r\n    +K('평가 금액',d.est)+K('가용',d.avail)+K('순손익 (분배 차감 후)',d.net,1)\r\n    +K('미실현 손익',d.unreal,1)+K('실현 손익',d.realized,1)+K('수익 분배 지급',d.share,0,'Profit share amount')\r\n    +'</div>'\r\n    +'<div class=\"tfbk-filters cpp-tabs\">'+TABS.map(function(t2){ return '<button type=\"button\" class=\"fp'+(tab===t2[0]?' on':'')+'\" aria-pressed=\"'+(tab===t2[0])+'\" onclick=\"cpDetailGo(\\''+cid+'\\',\\''+t2[0]+'\\')\">'+t2[1]+'</button>'; }).join('')+'</div>'\r\n    +body\r\n    +'<div class=\"cpp-foot\">USDT 표기. 시뮬레이션 데이터예요</div>'\r\n    +'</div>');\r\n  TF_RENDERING=false;\r\n  var sc=$('g-scroll'); if(sc) sc.scrollTop=0;\r\n}\r\n/* 설정 — 데모 범위: 페어 변경만 즉시, 모드/금액은 종료 후 재시작 안내 (상황 설명형) */\r\nfunction cpEditSheet(cid){\r\n  var c2=cpFind(cid); if(!c2) return;\r\n  tfSS3Dlg('따라가기 설정, '+c2.nick,\r\n    '<div class=\"ntc\">따라갈 페어: <b>'+c2.pairs.map(gEsc).join(', ')+'</b><br>최대 손실 '+((c2.adv&&c2.adv.maxLoss)||-20)+'%. 최대 손실 변경은 중단한 뒤 다시 시작할 때 고를 수 있어요.<br>예산은 예산 조정에서 언제든 바꿀 수 있어요.</div>'\r\n    +'<div class=\"acts3\" style=\"margin-top:16px\"><button type=\"button\" class=\"obtn\" onclick=\"tfSS3DlgClose()\">닫기</button>'\r\n    +'<button type=\"button\" class=\"wbtn\" onclick=\"tfSS3DlgClose();cpAdjDlg(\\''+cid+'\\')\">예산 조정 열기</button></div>');\r\n}\r\n/* 포지션 탭 — 오픈 포지션 파생 + 수동 정리 (성역: 크레딧과 무관하게 항상 가능) */\r\r\r\r\n/* 청산 이력 탭 */\r\nfunction cpxHist(c2,d){\r\n  var s2=tfSSFind(c2.nick);\r\n  var startI=c2.simStartI!=null?c2.simStartI:0, endI=c2.flatI!=null?c2.flatI:1e15;\r\n  var tr=(s2?s2.r.trades||[]:[]).filter(function(x){ var e=(x.exit!=null?x.exit:x.entry); return e>=startI&&e<=endI; }).slice(-30).reverse();\r\n  if(!tr.length) return '<div class=\"cpp-empty\"><b>아직 청산된 따라가기 거래가 없어요</b>첫 거래가 청산되면 진입가, 청산가, 손익이 여기에 쌓여요.</div>';\r\n  var wins=tr.filter(function(x){return x.pnl>0;}).length;\r"}

