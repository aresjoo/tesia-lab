alue)\"><span class=\"un\">%</span></span></div><div class=\"mk-f-hint\">건너뛰기는 다음 진입부터 따라가요. 주문당 상한은 한 번의 주문에 쓰는 예산 비율이에요.</div></details><button type=\"button\" class=\"mk-pri mk-f-cta\" id=\"cps-cta\" disabled=\"\" onclick=\"cpStart('%EB%8F%99%ED%96%89')\">따라가기 시작</button><div class=\"mk-f-foot\">시작 후에도 언제든 중단할 수 있어요. 수익이 나면 그중 10%가 전략 이용료로 나가요.</div></div></div>","stop":"function mkStopDlg(cid){\n  var c2=cpFind(cid); if(!c2||c2.status!=='active') return;\n  var d=cpCalc(c2);\n  var opt=function(k,t,sub){ return '<button type=\"button\" class=\"mk-stop-o\" onclick=\"mkStopGo(\\''+cid+'\\',\\''+k+'\\')\"><b>'+t+'</b><span>'+sub+'</span></button>'; };\n  tfSS3Dlg('따라가기 중단, '+c2.nick,\n    '<div class=\"ntc\">어떻게 정리할지 골라주세요. 어떤 선택이든 새 진입은 바로 멈춰요.</div>'\n    +'<div class=\"cpd-kv\" style=\"margin:0 0 14px\"><div><small>순손익 (분배 차감 후)</small><b class=\"num '+(d.net>=0?'u':'d')+'\">'+cpUsd(d.net)+'</b></div><div><small>돌려받을 예산</small><b class=\"num\">'+cpUsd(Math.max(0,d.est))+'</b></div></div>'\n    +'<div class=\"mk-stop\">'\n    +opt('now','지금 정리',d.posOpen?'열린 포지션을 현재가로 정리하고 예산을 바로 돌려받아요':'열린 포지션이 없어요. 예산을 바로 돌려받아요')\n    +opt('wait','원본 청산 대기','새 진입은 멈추고, 열린 포지션은 원본 전략이 청산할 때 함께 정리해요')\n    +opt('manual','직접 관리','새 진입은 멈추고, 열린 포지션은 내가 직접 정리해요')\n    +'</div>'\n    +'<div class=\"acts3\" style=\"margin-top:14px\"><button type=\"button\" class=\"obtn\" style=\"width:100%\" onclick=\"tfSS3DlgClose()\">계속 따라가기</button></div>');\n}","funcs":["stop","stopLive","gLiveStop","taiStop","TF_STOP","tfSS3Stop","tfSS3StopGo","tfBk2WKill","MK_STOP_L","mkStopDlg","tfTmHalt","tfTmHaltGo","mkStopGo"]}}

