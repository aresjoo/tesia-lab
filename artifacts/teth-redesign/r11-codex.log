function cpSetupRoute(h){
  if(!window.TF_STATE_READY||!TF_BOOTED) return; /* 부팅 재라우팅이 시트를 지우기 전에 기다린다 */
  var m=h.match(/^#\/share\/copy\/([^\/]+)$/);
  if(!m){ TF_ONSHARE=false; tfShareHub('find'); return; }
  var nick; try{ nick=decodeURIComponent(m[1]); }catch(e){ nick=m[1]; }
  var ne=tfSSNe(nick), pd=mkPd();
  try{ history.replaceState(null,'',location.pathname+location.search+'#/share/s/'+ne+'/'+pd); }catch(e){}
  tfSS3DetailRender(ne,pd,'ov');
  var target=location.hash;
  setTimeout(function(){ if(location.hash===target&&G.mode==='tfss3d'&&window.TF_STATE_READY&&tfSSFind(nick)) cpSetupGo(ne); },0);
}
function cpSetupView(ne){ mkFollowSheet(ne); }
